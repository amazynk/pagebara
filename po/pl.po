msgstr "Dodaje polecenie „Konwertuj na PDF” dla obrazów PNG i JPEG; plik PDF jest zapisywany obok pierwszego obrazu."

#: crates/integration/src/catalog.rs:261
msgid "Shows the first page of PDF documents as their icon in the file manager, drawn by this app."
msgstr "Wyświetla pierwszą stronę dokumentów PDF jako ich ikonę w menedżerze plików; rysuje ją ta aplikacja."

#: crates/integration/src/catalog.rs:270
msgid "Preview pane"
msgstr "Okienko podglądu"

#: crates/integration/src/catalog.rs:271
msgid "Shows PDF documents in the file manager's preview pane, drawn by this app."
msgstr "Wyświetla dokumenty PDF w okienku podglądu menedżera plików; rysuje je ta aplikacja."

#: crates/integration/src/catalog.rs:278
msgid "Search inside PDF documents"
msgstr "Wyszukiwanie w dokumentach PDF"

