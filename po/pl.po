msgstr "Zainstalowane przez pakiet ({})."

#: crates/integration/src/linux.rs:291
msgid "Only Thunar has a “Send To” menu that apps can add to; use the file manager menu entries instead."
msgstr "Tylko Thunar ma menu „Wyślij do”, do którego aplikacje mogą dodawać wpisy; zamiast tego użyj wpisów w menu menedżera plików."

#: crates/integration/src/linux.rs:326
msgid "No supported file manager found ({})."
msgstr "Nie znaleziono obsługiwanego menedżera plików ({})."

#: crates/integration/src/linux.rs:342
msgid "Not available on Linux."
msgstr "Niedostępne w systemie Linux."

#: crates/integration/src/macos.rs:207
msgid "Declared by the app bundle; macOS lists the app under “Open With”."
msgstr "Zadeklarowane przez pakiet aplikacji; macOS wyświetla aplikację w menu „Otwórz za pomocą”."

#: crates/integration/src/macos.rs:237
