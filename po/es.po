msgstr "Quitado parcialmente: {}"

#: crates/integration/src/lib.rs:92
msgid "Set up for another copy of the app; turn on again to repair"
msgstr "Configurado para otra copia de la aplicación; actívelo de nuevo para repararlo"

#: crates/integration/src/linux.rs:216
msgid "Not available in the Flatpak version: the sandbox cannot register with the desktop. Choose the default app in your system settings."
msgstr "No disponible en la versión Flatpak: el entorno aislado no puede registrarse en el escritorio. Elija la aplicación predeterminada en la configuración del sistema."

#: crates/integration/src/linux.rs:226
msgid "Registered by the installed package ({})."
msgstr "Registrado por el paquete instalado ({})."

#: crates/integration/src/linux.rs:277
msgid "Installed by the package ({})."
msgstr "Instalado por el paquete ({})."

#: crates/integration/src/linux.rs:291
msgid "Only Thunar has a “Send To” menu that apps can add to; use the file manager menu entries instead."
msgstr "Solo Thunar tiene un menú «Enviar a» al que las aplicaciones pueden añadir entradas; use en su lugar las entradas del menú del administrador de archivos."

#: crates/integration/src/linux.rs:326
msgid "No supported file manager found ({})."
msgstr "No se encontró ningún administrador de archivos compatible ({})."

#: crates/integration/src/linux.rs:342
msgid "Not available on Linux."
msgstr "No disponible en Linux."

#: crates/integration/src/macos.rs:207
msgid "Declared by the app bundle; macOS lists the app under “Open With”."
msgstr "Declarado por el paquete de la aplicación; macOS muestra la aplicación en «Abrir con»."

#: crates/integration/src/macos.rs:237
msgid "Not available on macOS."
msgstr "No disponible en macOS."

