<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX v4+ installer source. Built by build-msi.sh, which passes the variables below from
     crates/support/identity (UpgradeCode is derived from the app ID: keep the ID stable). -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="$(var.Name)" Manufacturer="$(var.Publisher)" Version="$(var.Version)"
           UpgradeCode="$(var.UpgradeCode)" Scope="perMachine" Compressed="yes">
    <!-- A rebuilt package of the same version replaces the installed one too, instead of
         being installed beside it as a second product. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of $(var.Name) is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The app's entry in Settings > Apps: its icon and where to read about it, get help
         and find new versions. -->
    <Icon Id="AppIcon" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="$(var.Homepage)" />
    <Property Id="ARPHELPLINK" Value="$(var.Repository)/issues" />
    <Property Id="ARPURLUPDATEINFO" Value="$(var.Repository)/releases" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.Name)">
        <Component Id="Exe">
          <File Id="ExeFile" Source="$(var.Exe)" KeyPath="yes" />
          <!-- "Open with" for .pdf; Windows lets the user pick the default handler (the
               app's Settings button opens Default apps at this registration). A second
               launch hands the file to the running window.
               The ProgID is plain registry values, not <ProgId><Extension>: that writes
               HKCR\.pdf's default value (making this app the PDF handler of every user who
               has not chosen one) and its Content Type, and uninstalling then deletes both,
               leaving .pdf with no handler and no MIME type. -->
          <RegistryKey Root="HKLM" Key="Software\Classes\$(var.AppId).pdf">
            <RegistryValue Value="PDF document" Type="string" />
            <RegistryValue Name="FriendlyTypeName" Value="PDF document" Type="string" />
            <RegistryValue Key="DefaultIcon" Value="&quot;[#ExeFile]&quot;,0" Type="string" />
            <RegistryValue Key="shell\open\command" Value="&quot;[#ExeFile]&quot; &quot;%1&quot;" Type="string" />
            <!-- Explorer's Print on a PDF: the app opens it with its print dialog. -->
            <RegistryValue Key="shell\print\command" Value="&quot;[#ExeFile]&quot; --print &quot;%1&quot;" Type="string" />
            <!-- The app's taskbar ID (it sets the same one): PDFs opened through this
                 registration show in its jump list. -->
            <RegistryValue Name="AppUserModelID" Value="$(var.AppId)" Type="string" />
          </RegistryKey>
          <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="$(var.Name)"
                         Value="Software\$(var.Name)\Capabilities" Type="string" />
          <RegistryKey Root="HKLM" Key="Software\$(var.Name)\Capabilities">
            <RegistryValue Name="ApplicationName" Value="$(var.Name)" Type="string" />
            <RegistryValue Name="ApplicationDescription" Value="$(var.Summary)" Type="string" />
            <RegistryValue Name="ApplicationIcon" Value="[#ExeFile],0" Type="string" />
            <RegistryValue Key="FileAssociations" Name=".pdf" Value="$(var.AppId).pdf" Type="string" />
            <RegistryValue Key="MimeAssociations" Name="application/pdf" Value="$(var.AppId).pdf" Type="string" />
          </RegistryKey>
          <RegistryValue Root="HKLM" Key="Software\Classes\.pdf\OpenWithProgids"
                         Name="$(var.AppId).pdf" Value="" Type="string" />
          <!-- "Open with" lists the app under its name, with its icon. -->
          <RegistryKey Root="HKLM" Key="Software\Classes\Applications\$(var.ExeName)">
            <RegistryValue Name="FriendlyAppName" Value="$(var.Name)" Type="string" />
            <RegistryValue Key="SupportedTypes" Name=".pdf" Value="" Type="string" />
            <RegistryValue Key="DefaultIcon" Value="[#ExeFile],0" Type="string" />
            <RegistryValue Key="shell\open\command" Value="&quot;[#ExeFile]&quot; &quot;%1&quot;" Type="string" />
          </RegistryKey>
        </Component>
        <!-- Explorer thumbnails, preview pane and Windows Search text. Not registered here:
             each is turned on per user in the app's Settings > System integration, which
             also removes exactly what it registered. -->
        <Component Id="ShellExtension">
          <File Id="ShellDllFile" Source="$(var.ShellDll)" Name="$(var.ShellDllName)" KeyPath="yes" />
        </Component>
        <Directory Id="DocFolder" Name="licences" />
      </Directory>
    </StandardDirectory>

    <!-- One component per notice: a component of several files without version numbers
         cannot have an automatic GUID (WIX0367). -->
    <ComponentGroup Id="Notices" Directory="DocFolder">
      <Component Id="NoticeMit">
        <File Source="$(var.Root)\LICENSE-MIT" KeyPath="yes" />
      </Component>
      <Component Id="NoticeApache">
        <File Source="$(var.Root)\LICENSE-APACHE" KeyPath="yes" />
      </Component>
      <Component Id="NoticeThirdParty">
        <File Source="$(var.Root)\THIRD-PARTY.md" KeyPath="yes" />
      </Component>
      <Component Id="NoticeThirdPartyLicences">
        <File Source="$(var.Root)\THIRD-PARTY-LICENSES.md" KeyPath="yes" />
      </Component>
      <Component Id="NoticeInter">
        <File Source="$(var.Root)\apps\desktop\ui\fonts\OFL.txt" Name="Inter-OFL.txt" KeyPath="yes" />
      </Component>
      <Component Id="NoticeAdobeCmap">
        <File Source="$(var.Root)\crates\content\LICENSE-adobe-cmap" Name="LICENSE-adobe-cmap.txt" KeyPath="yes" />
      </Component>
      <Component Id="NoticeHyphenation">
        <File Source="$(var.Root)\crates\typeset\LICENSE-hyphenation" Name="LICENSE-hyphenation.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenu">
        <Shortcut Id="StartMenuShortcut" Name="$(var.Name)" Description="$(var.Summary)"
                  Target="[INSTALLFOLDER]$(var.ExeName)" WorkingDirectory="INSTALLFOLDER">
          <!-- The app's taskbar ID (it sets the same one), so a pinned shortcut and the
               running window are one taskbar button with one jump list. -->
          <ShortcutProperty Key="System.AppUserModel.ID" Value="$(var.AppId)" />
        </Shortcut>
        <RegistryValue Root="HKLM" Key="Software\$(var.Name)" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- What the user turned on in Settings > System integration (thumbnails, the preview
         pane, the context menu, Send to) lives in their own registry hive and points at
         files in this folder, so uninstalling asks the app to take it out first. Run as the
         user who uninstalls, without waiting on its result; an update keeps everything.
         The Windows Search filter is machine-wide: it goes too when the uninstall was
         started with administrator rights, and otherwise from the app before uninstalling
         (Settings > System integration > Remove all system integration). -->
    <CustomAction Id="RemoveIntegration" Directory="INSTALLFOLDER" Execute="deferred"
                  Impersonate="yes" Return="ignore"
                  ExeCommand="&quot;[INSTALLFOLDER]$(var.ExeName)&quot; --integration remove-all" />
    <InstallExecuteSequence>
      <Custom Action="RemoveIntegration" Before="RemoveFiles"
              Condition="(REMOVE=&quot;ALL&quot;) AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Feature Id="Main">
      <ComponentRef Id="Exe" />
      <ComponentRef Id="ShellExtension" />
      <ComponentGroupRef Id="Notices" />
      <ComponentRef Id="StartMenu" />
    </Feature>
  </Package>
</Wix>
