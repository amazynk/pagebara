// Output tools: watermark, header and footer, Bates numbering and flatten (dialogs with a
// live preview Rust renders), and the setup of a comparison.
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { Button, IconButton } from "components/button.slint";
import { KeepInView } from "components/panel.slint";
import { TextField } from "components/text-field.slint";
import { SegmentedControl } from "components/segmented.slint";
import { Check, ColourRow, LabeledSlider } from "components/controls.slint";
import { Choice } from "components/dialog-parts.slint";

export global ProState {
    // 0 none, 1 watermark, 2 header and footer, 3 Bates numbering, 4 flatten, 5 compare.
    in-out property <int> dialog;
    // Watermark: 0 text, 1 picture, 2 page of a PDF.
    in-out property <int> wm-source;
    in-out property <string> wm-text: @tr("CONFIDENTIAL");
    in property <string> wm-file;
    in-out property <string> wm-page: "1";
    in property <[string]> fonts;
    in-out property <int> font;
    in-out property <int> colour: 5;
    // Percent of the page.
    in-out property <float> wm-size: 70;
    in-out property <float> wm-opacity: 30;
    // 0, 45, 90 or -45 degrees.
    in-out property <int> wm-rotation: 1;
    in-out property <int> wm-anchor: 4;
    in-out property <bool> wm-tiled;
    in-out property <bool> wm-behind;
    // 0 always, 1 on screen only, 2 in print only, 3 not in a layer.
    in-out property <int> wm-visibility;
    in property <[string]> presets;
    in-out property <int> preset: -1;
    in-out property <string> preset-name;
    // Pages to stamp (empty for all) and 0 all, 1 odd, 2 even of those.
    in-out property <string> pages;
    in-out property <int> parity;
    // Header and footer slots.
    in-out property <string> hf-tl;
    in-out property <string> hf-tc;
    in-out property <string> hf-tr;
    in-out property <string> hf-bl;
    // TRANSLATORS: default footer; keep {page} and {pages}, they become the page number and count
    in-out property <string> hf-bc: @tr("Page {{page}} of {{pages}}");
    in-out property <string> hf-br;
    in-out property <float> hf-size: 10;
    in-out property <string> hf-start: "1";
    in-out property <string> hf-margin: "36";
    in-out property <bool> hf-skip-first;
    // Bates numbering.
    in-out property <string> bates-prefix: "DOC-";
    in-out property <string> bates-suffix;
    in-out property <string> bates-digits: "6";
    in-out property <string> bates-start: "1";
    in-out property <int> bates-position: 5;
    in-out property <bool> bates-box;
    in property <[string]> bates-files;
    in property <string> bates-folder;
    // Flatten.
    in-out property <bool> fl-annots: true;
    in-out property <bool> fl-links;
    in-out property <bool> fl-forms: true;
    in-out property <bool> fl-signatures;
    // 0 apply, 1 merge, 2 keep.
    in-out property <int> fl-layers;
    in-out property <bool> fl-transparency;
    in property <string> fl-counts;
    // What the document has to flatten: comments, links, form fields, layers.
    in property <[int]> fl-has: [0, 0, 0, 0];
    in property <string> fl-warning;
    // Compare.
    in property <string> cmp-file;
    in-out property <bool> cmp-text: true;
    in-out property <bool> cmp-visual: true;
    in-out property <bool> cmp-annots: true;
    // Shared.
    in property <image> preview;
    in property <string> found;
    in property <string> status;
    in property <string> error;
    in property <bool> busy;
    callback action(what: string, value: string);
}

component Label inherits Text {
    color: Theme.muted;
    font-size: Theme.font-small;
    font-weight: 500;
}

component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;
    Label {
        text: root.label;
    }
    @children
}

// The page with the stamp as it will look.
component Preview inherits Rectangle {
    in property <string> note;
    // Sized by the layout only, never by the picture (which is sized from it).
    min-width: 0px;
    min-height: 360px;
    preferred-width: 300px;
    preferred-height: 360px;
    max-width: 100000px;
    max-height: 100000px;
    border-radius: Theme.radius;
    background: Theme.canvas;
    accessible-role: image;
    accessible-label: @tr("Preview of the first page stamped");
    property <float> aspect: ProState.preview.height / max(1, ProState.preview.width);
    Rectangle {
        width: min(parent.width - 24px, (parent.height - 24px) / max(0.1, parent.aspect));
        height: self.width * parent.aspect;
        background: #FFFFFF;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000033;
        Image {
            source: ProState.preview;
            width: parent.width;
            height: parent.height;
            image-fit: fill;
            preferred-width: 0px;
            preferred-height: 0px;
        }
    }
    if ProState.busy: Text {
        y: parent.height - 22px;
        text: @tr("Updating…");
        color: Theme.muted;
        font-size: Theme.font-small;
    }
}

// Which pages: a list and all, odd or even of them.
component PagesField inherits VerticalLayout {
    spacing: 4px;
    Label {
        text: @tr("Pages");
    }
    HorizontalLayout {
        spacing: 8px;
        TextField {
            horizontal-stretch: 1;
            placeholder: @tr("All pages, or for example 1-3, 7");
            label: @tr("Pages");
            text <=> ProState.pages;
            edited => {
                ProState.action("changed", "");
            }
        }
        SegmentedControl {
            name: @tr("Which of those pages");
            items: [{ label: @tr("All") }, { label: @tr("Odd") }, { label: @tr("Even") }];
            selected <=> ProState.parity;
            activated => {
                ProState.action("changed", "");
            }
        }
    }
}

component Slot inherits TextField {
    edited => {
        ProState.action("changed", "");
    }
}

// A third of a header or footer row, the same width whatever its text.
component ThirdSlot inherits Slot {
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
}

component WatermarkPane inherits VerticalLayout {
    spacing: 10px;
    SegmentedControl {
        stretch: true;
        name: @tr("Watermark from");
        items: [{ label: @tr("Text") }, { label: @tr("Picture") }, { label: @tr("PDF page") }];
        selected <=> ProState.wm-source;
        activated => {
            ProState.action("changed", "");
        }
    }
    if ProState.wm-source == 0: TextField {
        label: @tr("Watermark text");
        placeholder: @tr("Watermark text");
        text <=> ProState.wm-text;
        edited => {
            ProState.action("changed", "");
        }
    }
    if ProState.wm-source == 0: HorizontalLayout {
        spacing: 12px;
        Field {
            label: @tr("Font");
            horizontal-stretch: 1;
            Choice {
                model: ProState.fonts;
                current-index <=> ProState.font;
                label: @tr("Font");
                selected => {
                    ProState.action("changed", "");
                }
            }
        }
        Field {
            label: @tr("Colour");
            ColourRow {
                selected: ProState.colour;
                name: @tr("Watermark colour");
                picked(i) => {
                    ProState.colour = i;
                    ProState.action("changed", "");
                }
            }
        }
    }
    if ProState.wm-source != 0: HorizontalLayout {
        spacing: 8px;
        Text {
            text: ProState.wm-file == "" ? @tr("No file chosen") : ProState.wm-file;
            color: ProState.wm-file == "" ? Theme.muted : Theme.text;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if ProState.wm-source == 2: TextField {
            width: 64px;
            label: @tr("Page of that PDF");
            text <=> ProState.wm-page;
            edited => {
                ProState.action("changed", "");
            }
        }
        Button {
            text: @tr("Choose…");
            clicked => {
                ProState.action("choose-file", "");
            }
        }
    }
    HorizontalLayout {
        spacing: 12px;
        LabeledSlider {
            horizontal-stretch: 1;
            label: @tr("Size");
            value-text: @tr("{}% of the page", round(ProState.wm-size));
            minimum: 5;
            maximum: 100;
            value <=> ProState.wm-size;
            released => {
                ProState.action("changed", "");
            }
        }
        LabeledSlider {
            horizontal-stretch: 1;
            label: @tr("Opacity");
            value-text: round(ProState.wm-opacity) + "%";
            minimum: 5;
            maximum: 100;
            value <=> ProState.wm-opacity;
            released => {
                ProState.action("changed", "");
            }
        }
    }
    HorizontalLayout {
        spacing: 16px;
        Field {
            label: @tr("Position");
            // The 3 × 3 grid of places on the page.
            Rectangle {
                width: 84px;
                height: 84px;
                border-radius: Theme.radius-small;
                border-width: 1px;
                border-color: Theme.border;
                accessible-role: radio-group;
                accessible-label: @tr("Position on the page");
                for i in 9: Rectangle {
                    x: 4px + mod(i, 3) * 26px;
                    y: 4px + floor(i / 3) * 26px;
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    background: i == ProState.wm-anchor ? Theme.accent : (ta.has-hover ? Theme.hover : Theme.track);
                    accessible-role: radio-button;
                    accessible-label: [@tr("Top left"), @tr("Top"), @tr("Top right"), @tr("Left"), @tr("Centre"), @tr("Right"), @tr("Bottom left"), @tr("Bottom"), @tr("Bottom right")][i];
                    accessible-checkable: true;
                    accessible-checked: i == ProState.wm-anchor;
                    accessible-action-default => {
                        ProState.wm-anchor = i;
                        ProState.action("changed", "");
                    }
                    ta := TouchArea {
                        clicked => {
                            ProState.wm-anchor = i;
                            ProState.action("changed", "");
                        }
                    }
                }
            }
        }
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            Field {
                label: @tr("Angle");
                SegmentedControl {
                    stretch: true;
                    name: @tr("Angle");
                    items: [{ label: "0°" }, { label: "45°" }, { label: "90°" }, { label: "−45°" }];
                    selected <=> ProState.wm-rotation;
                    activated => {
                        ProState.action("changed", "");
                    }
                }
            }
            HorizontalLayout {
                Check {
                    text: @tr("Repeat over the page");
                    checked <=> ProState.wm-tiled;
                    toggled => {
                        ProState.action("changed", "");
                    }
                }
                Check {
                    text: @tr("Behind the content");
                    checked <=> ProState.wm-behind;
                    toggled => {
                        ProState.action("changed", "");
                    }
                }
            }
        }
    }
    Field {
        // TRANSLATORS: label before when the watermark shows (always, on screen, in print)
        label: @tr("Show");
        SegmentedControl {
            stretch: true;
            name: @tr("When the watermark shows");
            items: [{ label: @tr("Always") }, { label: @tr("On screen") }, { label: @tr("In print") }, { label: @tr("No layer") }];
            selected <=> ProState.wm-visibility;
        }
    }
    PagesField { }
    HorizontalLayout {
        spacing: 8px;
        Field {
            label: @tr("Saved settings");
            horizontal-stretch: 1;
            Choice {
                model: ProState.presets;
                current-index <=> ProState.preset;
                label: @tr("Saved settings");
                selected(i) => {
                    ProState.action("load-preset", i);
                }
            }
        }
        VerticalLayout {
            alignment: end;
            Button {
                text: @tr("Save as…");
                clicked => {
                    ProState.action("save-preset", "");
                }
            }
        }
    }
}

component HeaderPane inherits VerticalLayout {
    in property <bool> bates;
    spacing: 10px;
    if !root.bates: VerticalLayout {
        spacing: 6px;
        Label {
            text: @tr("Header");
        }
        HorizontalLayout {
            spacing: 6px;
            ThirdSlot {
                label: @tr("Header left");
                placeholder: @tr("Left");
                text <=> ProState.hf-tl;
            }
            ThirdSlot {
                label: @tr("Header centre");
                placeholder: @tr("Centre");
                text <=> ProState.hf-tc;
            }
            ThirdSlot {
                label: @tr("Header right");
                placeholder: @tr("Right");
                text <=> ProState.hf-tr;
            }
        }
        Label {
            text: @tr("Footer");
        }
        HorizontalLayout {
            spacing: 6px;
            ThirdSlot {
                label: @tr("Footer left");
                placeholder: @tr("Left");
                text <=> ProState.hf-bl;
            }
            ThirdSlot {
                label: @tr("Footer centre");
                placeholder: @tr("Centre");
                text <=> ProState.hf-bc;
            }
            ThirdSlot {
                label: @tr("Footer right");
                placeholder: @tr("Right");
                text <=> ProState.hf-br;
            }
        }
        Text {
            // TRANSLATORS: keep the words in braces as they are
            text: @tr("Use {{page}}, {{pages}}, {{label}}, {{date}}, {{date:%d.%m.%Y}}, {{time}}, {{file}}, {{title}} and {{author}}.");
            color: Theme.muted;
            font-size: Theme.font-small;
            wrap: word-wrap;
            line-height-factor: 1.15;
        }
    }
    if root.bates: VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            Field {
                label: @tr("Prefix");
                horizontal-stretch: 2;
                Slot {
                    label: @tr("Prefix");
                    text <=> ProState.bates-prefix;
                }
            }
            Field {
                label: @tr("Digits");
                horizontal-stretch: 1;
                Slot {
                    label: @tr("Digits");
                    text <=> ProState.bates-digits;
                }
            }
            Field {
                label: @tr("First number");
                horizontal-stretch: 1;
                Slot {
                    label: @tr("First number");
                    text <=> ProState.bates-start;
                }
            }
            Field {
                label: @tr("Suffix");
                horizontal-stretch: 2;
                Slot {
                    label: @tr("Suffix");
                    text <=> ProState.bates-suffix;
                }
            }
        }
        Field {
            label: @tr("Position");
            SegmentedControl {
                stretch: true;
                name: @tr("Position of the number");
                items: [{ label: @tr("Top left") }, { label: @tr("Top") }, { label: @tr("Top right") }, { label: @tr("Bottom left") }, { label: @tr("Bottom") }, { label: @tr("Bottom right") }];
                selected <=> ProState.bates-position;
                activated => {
                    ProState.action("changed", "");
                }
            }
        }
        Check {
            text: @tr("On a white box");
            checked <=> ProState.bates-box;
            toggled => {
                ProState.action("changed", "");
            }
        }
        Field {
            label: @tr("Files, numbered in this order (this document first)");
            Rectangle {
                height: 96px;
                border-radius: Theme.radius-small;
                border-width: 1px;
                border-color: Theme.border;
                Flickable {
                    content-height: files.preferred-height;
                    files := VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        for f[i] in ProState.bates-files: HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: (i + 1) + ". " + f;
                                color: Theme.text;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            if i > 0: IconButton {
                                icon: @image-url("icons/close.svg");
                                label: @tr("Remove {}", f);
                                clicked => {
                                    ProState.action("remove-file", i);
                                }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: @tr("Add files…");
                    clicked => {
                        ProState.action("add-files", "");
                    }
                }
                Text {
                    text: ProState.bates-files.length > 1 ? @tr("Numbered copies go to {}, with a list of the ranges.", ProState.bates-folder) : "";
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                    line-height-factor: 1.15;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 12px;
        Field {
            label: @tr("Font");
            horizontal-stretch: 2;
            Choice {
                model: ProState.fonts;
                current-index <=> ProState.font;
                label: @tr("Font");
                selected => {
                    ProState.action("changed", "");
                }
            }
        }
        Field {
            // TRANSLATORS: pt: points, the unit of type sizes
            label: @tr("Size (pt)");
            horizontal-stretch: 1;
            TextField {
                label: @tr("Font size");
                text: round(ProState.hf-size);
                edited(t) => {
                    if t.to-float() >= 4 && t.to-float() <= 72 {
                        ProState.hf-size = t.to-float();
                        ProState.action("changed", "");
                    }
                }
            }
        }
        Field {
            label: @tr("Margin (pt)");
            horizontal-stretch: 1;
            Slot {
                label: @tr("Margin in points");
                text <=> ProState.hf-margin;
            }
        }
        if !root.bates: Field {
            label: @tr("First number");
            horizontal-stretch: 1;
            Slot {
                label: @tr("First page number");
                text <=> ProState.hf-start;
            }
        }
    }
    Field {
        label: @tr("Colour");
        ColourRow {
            selected: ProState.colour;
            name: @tr("Text colour");
            picked(i) => {
                ProState.colour = i;
                ProState.action("changed", "");
            }
        }
    }
    if !root.bates: Check {
        text: @tr("Not on the first page");
        checked <=> ProState.hf-skip-first;
        toggled => {
            ProState.action("changed", "");
        }
    }
    if !root.bates: PagesField { }
}

component FlattenPane inherits VerticalLayout {
    spacing: 8px;
    Text {
        text: @tr("Flattening makes comments, form fields and layers part of the page: they look the same but can no longer be changed.");
        color: Theme.text;
        wrap: word-wrap;
        line-height-factor: 1.15;
    }
    Text {
        text: ProState.fl-counts;
        color: Theme.muted;
        font-size: Theme.font-small;
        wrap: word-wrap;
        line-height-factor: 1.15;
    }
    Check {
        text: @tr("Comments and markup");
        checked <=> ProState.fl-annots;
        toggled => {
            ProState.action("changed", "");
        }
    }
    Check {
        text: @tr("Links too");
        enabled: ProState.fl-annots;
        checked <=> ProState.fl-links;
    }
    Check {
        text: @tr("Form fields, with their values");
        checked <=> ProState.fl-forms;
        toggled => {
            ProState.action("changed", "");
        }
    }
    Check {
        text: @tr("Signatures too (they stop being valid)");
        enabled: ProState.fl-forms;
        checked <=> ProState.fl-signatures;
    }
    Field {
        label: @tr("Layers");
        SegmentedControl {
            stretch: true;
            name: @tr("Layers");
            items: [{ label: @tr("Keep what shows") }, { label: @tr("Merge all") }, { label: @tr("Leave layers") }];
            selected <=> ProState.fl-layers;
            activated => {
                ProState.action("changed", "");
            }
        }
    }
    Check {
        text: @tr("Transparency (areas become pictures, 200 dpi)");
        checked <=> ProState.fl-transparency;
    }
    if ProState.fl-warning != "": Text {
        text: ProState.fl-warning;
        color: Theme.danger;
        wrap: word-wrap;
        line-height-factor: 1.15;
    }
}

component ComparePane inherits VerticalLayout {
    spacing: 10px;
    Text {
        text: @tr("Compare “{}” (old) with another version (new): changed words, moved text, inserted and removed pages, what looks different, comments, properties and form values.", AppState.title);
        color: Theme.text;
        wrap: word-wrap;
        line-height-factor: 1.15;
    }
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: ProState.cmp-file == "" ? @tr("No file chosen") : ProState.cmp-file;
            color: ProState.cmp-file == "" ? Theme.muted : Theme.text;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Button {
            text: @tr("Choose…");
            clicked => {
                ProState.action("choose-compare", "");
            }
        }
    }
    Check {
        text: @tr("Text");
        checked <=> ProState.cmp-text;
    }
    Check {
        text: @tr("How pages look");
        checked <=> ProState.cmp-visual;
    }
    Check {
        text: @tr("Comments, properties and form values");
        checked <=> ProState.cmp-annots;
    }
}

export component ProDialog inherits Rectangle {
    property <bool> with-preview: ProState.dialog >= 1 && ProState.dialog <= 3;
    background: Theme.scrim;
    accessible-role: none;
    forward-focus: keys;

    TouchArea { }

    // Shift+Tab from the card's start lands here: back to the start.
    FocusScope {
        width: 0px;
        height: 0px;
        changed has-focus => {
            if self.has-focus {
                keys.focus();
            }
        }
    }

    card := Rectangle {
        width: min(root.with-preview ? 900px : 520px, root.width - 32px);
        height: min(content.preferred-height, root.height - 32px);
        background: Theme.chrome;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000040;
        accessible-role: groupbox;
        accessible-label: title.text;

        keys := FocusScope {
            key-pressed(e) => {
                if e.text == Key.Escape {
                    ProState.action("cancel", "");
                    return accept;
                }
                if AppState.shortcut(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt, e.modifiers.meta) {
                    return accept;
                }
                reject
            }
            init => {
                self.focus();
            }

            KeepInView {
                inner-height: content.preferred-height;
                content := VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    HorizontalLayout {
                        title := Text {
                            text: ["", @tr("Watermark"), @tr("Header and footer"), @tr("Bates numbering"), @tr("Flatten"), @tr("Compare")][ProState.dialog];
                            color: Theme.text;
                            font-size: Theme.font-heading;
                            font-weight: 600;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            icon: @image-url("icons/close.svg");
                            label: @tr("Close");
                            clicked => {
                                ProState.action("cancel", "");
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 20px;
                        VerticalLayout {
                            width: root.with-preview ? 500px : card.width - 48px;
                            if ProState.dialog == 1: WatermarkPane { }
                            if ProState.dialog == 2: HeaderPane { }
                            if ProState.dialog == 3: HeaderPane {
                                bates: true;
                            }
                            if ProState.dialog == 4: FlattenPane { }
                            if ProState.dialog == 5: ComparePane { }
                        }
                        if root.with-preview: Preview {
                            horizontal-stretch: 1;
                            min-height: 360px;
                        }
                    }
                    if ProState.error != "": Text {
                        text: ProState.error;
                        color: Theme.danger;
                        wrap: word-wrap;
                        line-height-factor: 1.15;
                    }
                    if ProState.status != "": Text {
                        text: ProState.status;
                        color: Theme.muted;
                        wrap: word-wrap;
                        line-height-factor: 1.15;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        if ProState.found != "" && (ProState.dialog == 1 || ProState.dialog == 2 || ProState.dialog == 3): Button {
                            text: @tr("Remove {}", ProState.found);
                            clicked => {
                                ProState.action("remove", "");
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: @tr("Cancel");
                            clicked => {
                                ProState.action("cancel", "");
                            }
                        }
                        Button {
                            text: ["", @tr("Add watermark"), @tr("Add header and footer"), @tr("Bates numbering" => "Number"), @tr("Flatten"), @tr("Compare")][ProState.dialog];
                            primary: true;
                            // Flatten: something to flatten with these choices; Compare: a file.
                            enabled: ProState.dialog == 4 ? ProState.fl-transparency || (ProState.fl-annots && (ProState.fl-has[0] > 0 || (ProState.fl-links && ProState.fl-has[1] > 0))) || (ProState.fl-forms && ProState.fl-has[2] > 0) || (ProState.fl-layers != 2 && ProState.fl-has[3] > 0) : ProState.dialog == 5 ? !ProState.busy && ProState.cmp-file != "" : true;
                            clicked => {
                                ProState.action("apply", "");
                            }
                        }
                    }
                }
            }
        }
    }

    // Tab from the card's end lands here: round to its start.
    FocusScope {
        width: 0px;
        height: 0px;
        changed has-focus => {
            if self.has-focus {
                keys.focus();
            }
        }
    }
}
