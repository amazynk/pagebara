import { ComboBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { Button, IconButton } from "components/button.slint";
import { KeepInView } from "components/panel.slint";
import { TextField } from "components/text-field.slint";
import { SegmentedControl } from "components/segmented.slint";
import { Check } from "components/controls.slint";

// The print dialog's choices; Rust renders the preview and the print file.
export global PrintState {
    in property <bool> visible;
    in property <[string]> printers;
    in-out property <int> printer;
    // Why printing is not possible, or how it is limited here.
    in property <string> note;
    in property <bool> can-print;
    in-out property <int> copies: 1;
    // 0 all, 1 current page, 2 pages typed in, 3 pages selected in the organize view.
    in-out property <int> range;
    in-out property <string> range-text;
    in property <bool> has-selection;
    // 0 fit, 1 actual size, 2 custom.
    in-out property <int> scale;
    in-out property <float> custom-scale: 100;
    in property <[string]> papers;
    in-out property <int> paper;
    in-out property <bool> auto-rotate: true;
    in-out property <bool> centre: true;
    in-out property <bool> annotations: true;
    in-out property <bool> forms: true;
    in-out property <bool> greyscale;
    // 0 one-sided, 1 long edge, 2 short edge.
    in-out property <int> duplex;
    in property <bool> duplex-available;
    // 0 150 dpi, 1 300 dpi, 2 600 dpi.
    in-out property <int> quality: 1;
    in property <[image]> previews;
    in property <string> summary;
    in property <bool> busy;
    in property <string> status;
    in property <string> error;
    callback open();
    callback changed();
    callback print();
    callback save-pdf();
    callback close();
}

component Label inherits Text {
    color: Theme.muted;
    font-size: Theme.font-small;
    font-weight: 500;
}

component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;
    Label {
        text: root.label;
    }
    @children
}

// A modal card over the dimmed window, like the other dialogs.
export component PrintDialog inherits Rectangle {
    background: Theme.scrim;
    accessible-role: none;
    forward-focus: keys;

    TouchArea { }

    // Shift+Tab from the card's start lands here: back to the start.
    FocusScope {
        width: 0px;
        height: 0px;
        changed has-focus => {
            if self.has-focus {
                keys.focus();
            }
        }
    }

    card := Rectangle {
        width: min(820px, root.width - 32px);
        height: min(content.preferred-height, root.height - 32px);
        background: Theme.chrome;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000040;
        accessible-role: groupbox;
        accessible-label: @tr("Print");

        keys := FocusScope {
            key-pressed(e) => {
                if AppState.shortcut(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt, e.modifiers.meta) {
                    return accept;
                }
                reject
            }
            init => {
                self.focus();
            }

            KeepInView {
                inner-height: content.preferred-height;
                content := VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    HorizontalLayout {
                        Text {
                            text: @tr("Print “{}”", AppState.title);
                            color: Theme.text;
                            font-size: Theme.font-heading;
                            font-weight: 600;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            icon: @image-url("icons/close.svg");
                            label: @tr("Close print dialog");
                            clicked => {
                                PrintState.close();
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 20px;

                        // The choices.
                        VerticalLayout {
                            width: 380px;
                            spacing: 10px;

                            Field {
                                label: @tr("Printer");
                                if PrintState.printers.length > 0: ComboBox {
                                    model: PrintState.printers;
                                    current-index <=> PrintState.printer;
                                    current-value: PrintState.printers[PrintState.printer];
                                    accessible-label: @tr("Printer");
                                    selected => {
                                        PrintState.changed();
                                    }
                                }
                                if PrintState.note != "": Text {
                                    text: PrintState.note;
                                    color: Theme.muted;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                    line-height-factor: 1.15;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Field {
                                    label: @tr("Copies");
                                    HorizontalLayout {
                                        spacing: 2px;
                                        IconButton {
                                            icon: @image-url("icons/minus.svg");
                                            label: @tr("Fewer copies");
                                            enabled: PrintState.copies > 1;
                                            clicked => {
                                                PrintState.copies = max(1, PrintState.copies - 1);
                                            }
                                        }
                                        Text {
                                            text: PrintState.copies;
                                            width: 32px;
                                            color: Theme.text;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            accessible-role: text;
                                            accessible-label: @tr("Copies {}", PrintState.copies);
                                        }
                                        IconButton {
                                            icon: @image-url("icons/plus.svg");
                                            label: @tr("More copies");
                                            enabled: PrintState.copies < 999;
                                            clicked => {
                                                PrintState.copies = min(999, PrintState.copies + 1);
                                            }
                                        }
                                    }
                                }
                                Field {
                                    label: @tr("Paper");
                                    horizontal-stretch: 1;
                                    ComboBox {
                                        model: PrintState.papers;
                                        current-index <=> PrintState.paper;
                                    current-value: PrintState.papers[PrintState.paper];
                                        accessible-label: @tr("Paper size");
                                        selected => {
                                            PrintState.changed();
                                        }
                                    }
                                }
                            }

                            Field {
                                label: @tr("Pages");
                                SegmentedControl {
                                    stretch: true;
                                    name: @tr("Pages to print");
                                    items: [{ label: @tr("All") }, { label: @tr("Current") }, { label: @tr("Pages") }, { label: @tr("Selected") }];
                                    selected <=> PrintState.range;
                                    activated => {
                                        PrintState.changed();
                                    }
                                }
                                if PrintState.range == 2: TextField {
                                    placeholder: @tr("For example 1-3, 5");
                                    label: @tr("Pages to print");
                                    text <=> PrintState.range-text;
                                    edited => {
                                        PrintState.changed();
                                    }
                                }
                                if PrintState.range == 3 && !PrintState.has-selection: Text {
                                    text: @tr("Select pages in Organize pages first.");
                                    color: Theme.muted;
                                    font-size: Theme.font-small;
                                }
                            }

                            Field {
                                label: @tr("Scale");
                                HorizontalLayout {
                                    spacing: 8px;
                                    SegmentedControl {
                                        horizontal-stretch: 1;
                                        stretch: true;
                                        name: @tr("Scale");
                                        items: [{ label: @tr("Fit to paper") }, { label: @tr("Actual size") }, { label: @tr("Custom") }];
                                        selected <=> PrintState.scale;
                                        activated => {
                                            PrintState.changed();
                                        }
                                    }
                                    if PrintState.scale == 2: TextField {
                                        width: 72px;
                                        label: @tr("Scale percent");
                                        text: round(PrintState.custom-scale);
                                        edited(t) => {
                                            if t.to-float() > 0 {
                                                PrintState.custom-scale = t.to-float();
                                                PrintState.changed();
                                            }
                                        }
                                    }
                                }
                            }

                            GridLayout {
                                spacing: 2px;
                                Row {
                                    Check {
                                        text: @tr("Rotate to fit the paper");
                                        checked <=> PrintState.auto-rotate;
                                        toggled => {
                                            PrintState.changed();
                                        }
                                    }
                                    Check {
                                        text: @tr("Centre on the paper");
                                        checked <=> PrintState.centre;
                                        toggled => {
                                            PrintState.changed();
                                        }
                                    }
                                }
                                Row {
                                    Check {
                                        text: @tr("Comments and markup");
                                        checked <=> PrintState.annotations;
                                        toggled => {
                                            PrintState.changed();
                                        }
                                    }
                                    Check {
                                        text: @tr("Form fields");
                                        checked <=> PrintState.forms;
                                        toggled => {
                                            PrintState.changed();
                                        }
                                    }
                                }
                            }

                            Field {
                                label: @tr("Colour");
                                SegmentedControl {
                                    stretch: true;
                                    name: @tr("Colour");
                                    items: [{ label: @tr("Colour") }, { label: @tr("Greyscale") }];
                                    selected: PrintState.greyscale ? 1 : 0;
                                    activated(i) => {
                                        PrintState.greyscale = i == 1;
                                        PrintState.changed();
                                    }
                                }
                            }

                            if PrintState.duplex-available: Field {
                                label: @tr("Both sides");
                                SegmentedControl {
                                    stretch: true;
                                    name: @tr("Two-sided");
                                    items: [{ label: @tr("One side") }, { label: @tr("Long edge") }, { label: @tr("Short edge") }];
                                    selected <=> PrintState.duplex;
                                }
                            }

                            Field {
                                label: @tr("Quality");
                                SegmentedControl {
                                    stretch: true;
                                    name: @tr("Quality");
                                    items: [{ label: @tr("Draft 150 dpi") }, { label: @tr("Normal 300 dpi") }, { label: @tr("High 600 dpi") }];
                                    selected <=> PrintState.quality;
                                }
                            }
                        }

                        // The preview of the first sheets.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;
                            Label {
                                text: @tr("Preview");
                            }
                            preview := Rectangle {
                                height: 300px;
                                border-radius: Theme.radius;
                                background: Theme.canvas;
                                accessible-role: image;
                                accessible-label: @tr("Print preview");
                                property <length> slot: 112px;
                                property <int> count: PrintState.previews.length;
                                for img[i] in PrintState.previews: Rectangle {
                                    property <float> aspect: img.height / max(1, img.width);
                                    width: min(preview.slot, 270px / max(0.1, aspect));
                                    height: self.width * aspect;
                                    x: (preview.width - preview.count * preview.slot - (preview.count - 1) * 10px) / 2 + i * (preview.slot + 10px) + (preview.slot - self.width) / 2;
                                    y: (preview.height - self.height) / 2;
                                    background: #FFFFFF;
                                    drop-shadow-blur: 6px;
                                    drop-shadow-color: #00000033;
                                    Image {
                                        accessible-label: @tr("Preview of sheet {}", i + 1);
                                        source: img;
                                        width: parent.width;
                                        height: parent.height;
                                        image-fit: fill;
                                    }
                                }
                            }
                            Text {
                                text: PrintState.summary;
                                color: Theme.muted;
                                font-size: Theme.font-small;
                                horizontal-alignment: center;
                                accessible-role: text;
                                accessible-label: @tr("Print summary");
                            }
                        }
                    }

                    if PrintState.error != "": Text {
                        text: PrintState.error;
                        color: Theme.danger;
                        wrap: word-wrap;
                        line-height-factor: 1.15;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: @tr("Save as PDF for printing…");
                            enabled: !PrintState.busy;
                            clicked => {
                                PrintState.save-pdf();
                            }
                        }
                        Text {
                            text: PrintState.status;
                            color: Theme.muted;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Button {
                            text: @tr("Cancel");
                            clicked => {
                                PrintState.close();
                            }
                        }
                        print-button := Button {
                            text: @tr("Print");
                            primary: true;
                            enabled: PrintState.can-print && !PrintState.busy;
                            clicked => {
                                PrintState.print();
                            }
                        }
                    }
                }
            }
        }
    }

    // Tab from the card's end lands here: round to its start.
    FocusScope {
        width: 0px;
        height: 0px;
        changed has-focus => {
            if self.has-focus {
                keys.focus();
            }
        }
    }
}
