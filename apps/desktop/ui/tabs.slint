import { RowLayout } from "components/row.slint";
import { Theme } from "theme.slint";
import { AppState, Chrome, TabInfo } from "state.slint";
import { KeepInView } from "components/panel.slint";
import { IconButton, Pressable, Keys } from "components/button.slint";

// Open documents, one tab each. Middle-click or the cross closes a tab; a tab dragged
// off the bar opens in a window of its own.
export component TabBar inherits Rectangle {
    // The tab being dragged off the bar.
    property <int> torn: -1;
    // Room kept free at the start for the window's own buttons, when this bar is also
    // the window's title bar.
    in property <length> inset: 0px;
    in property <length> window-height;
    property <length> margin: 8px;
    property <length> gap: 2px;
    property <length> button-size: Theme.touch ? 40px : 30px;
    property <length> available: self.width - inset - 2 * margin - 2 * button-size - 12px;
    property <int> capacity: max(1, floor((available + gap) / (144px * max(1, Theme.text-scale) + gap)));
    property <int> shown: min(capacity, AppState.tabs.length);
    property <int> first: min(floor(AppState.active-tab / capacity) * capacity, AppState.tabs.length - shown);
    property <length> tab-width: min(220px, (available + gap) / max(1, shown) - gap);
    property <length> strip-start: Theme.rtl ? self.width - margin - inset : margin + inset;
    property <int> menu-index;
    property <int> menu-focus;
    function focus-entry(index: int) {
        menu-index = clamp(index, 0, AppState.tabs.length - 1);
        menu-focus += 1;
    }

    height: Theme.touch ? 48px : Chrome.unified ? 40px : 36px;
    min-width: 0px;
    background: Theme.canvas;
    accessible-role: tab-list;
    accessible-label: @tr("Open documents");

    // As the window's title bar: dragging it moves the window, a double click zooms it.
    if Chrome.unified: TouchArea {
        moved => {
            if self.pressed && (abs(self.mouse-x - self.pressed-x) > 3px || abs(self.mouse-y - self.pressed-y) > 3px) {
                Chrome.drag-window();
            }
        }
        double-clicked => {
            Chrome.zoom-window();
        }
    }

    for offset in root.shown: Pressable {
        property <int> i: root.first + offset;
        property <TabInfo> t: AppState.tabs[self.i];
        x: Theme.rtl ? root.strip-start - (offset + 1) * root.tab-width - offset * root.gap
                     : root.strip-start + offset * (root.tab-width + root.gap);
        y: 4px;
        width: root.tab-width;
        height: root.height - 6px;
        border-radius: 7px;
        background: t.active ? Theme.chrome : self.has-hover ? Theme.hover : transparent;
        opacity: root.torn == i ? 0.5 : 1;
        border-width: t.active && Theme.high-contrast ? 1px : 0px;
        border-color: Theme.text;
        arrows: false;
        accessible-role: tab;
        label: t.title;
        description: t.folder + (t.dirty ? " · " + @tr("Unsaved changes") : "");
        accessible-item-selectable: true;
        accessible-item-selected: t.active;
        accessible-item-index: i;
        accessible-item-count: AppState.tabs.length;
        clicked => {
            AppState.select-tab(i);
        }
        pointer(e) => {
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.middle {
                AppState.close-tab(i);
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                if root.torn == i {
                    root.torn = -1;
                    AppState.tab-torn-off(i);
                }
                root.torn = -1;
            }
        }
        moved(x, y, px, py, pressed) => {
            root.torn = pressed && (y < -48px || y > self.height + 48px) ? i : -1;
        }
        if t.active: Rectangle {
            x: 8px;
            y: parent.height - 2px;
            width: parent.width - 16px;
            height: 2px;
            border-radius: 1px;
            background: Theme.accent-fg;
            accessible-role: none;
        }
        RowLayout {
            padding-left: 8px;
            padding-right: 4px;
            spacing: 4px;
            if !t.dirty: Image {
                width: 14px;
                height: 14px;
                cross-axis-self-alignment: center;
                source: @image-url("icons/file.svg");
                colorize: t.active ? Theme.accent-fg : Theme.faint;
                accessible-role: none;
            }
            if t.dirty: Rectangle {
                width: 7px;
                height: 7px;
                cross-axis-self-alignment: center;
                border-radius: 3.5px;
                background: Theme.accent-fg;
                accessible-role: none;
            }
            Text {
                text: t.title;
                color: t.active ? Theme.text : Theme.muted;
                font-size: Theme.font-small;
                font-weight: t.active ? 600 : 500;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                accessible-role: none;
            }
            IconButton {
                cross-axis-self-alignment: center;
                width: root.button-size - 4px;
                height: parent.height - 4px;
                icon: @image-url("icons/close.svg");
                icon-size: 12px;
                label: @tr("Close {}", t.title);
                clicked => {
                    AppState.close-tab(i);
                }
            }
        }
    }
    add := IconButton {
        x: Theme.rtl ? root.strip-start - root.shown * (root.tab-width + root.gap) - self.width - 3px
                     : root.strip-start + root.shown * (root.tab-width + root.gap) + 3px;
        width: root.button-size;
        height: root.button-size;
        icon: @image-url("icons/plus.svg");
        icon-size: 16px;
        label: @tr("Open another document");
        description: "Ctrl+T";
        clicked => { AppState.open-file(); }
    }

    switcher := IconButton {
        x: Theme.rtl ? root.margin : root.width - root.margin - self.width;
        width: root.button-size;
        height: root.button-size;
        icon: @image-url("icons/chevron-down.svg");
        icon-size: 16px;
        label: @tr("Switch document");
        description: Keys.label("Ctrl+Tab", true);
        accessible-expandable: true;
        accessible-expanded: documents.is-open;
        clicked => {
            documents.show();
            root.focus-entry(AppState.active-tab);
        }
    }
    documents := PopupWindow {
        x: Theme.rtl ? root.margin : root.width - root.margin - self.width;
        y: root.height;
        width: min(360px, root.width - 16px);
        property <length> row-height: max(44px, 40px * Theme.text-scale);
        height: min(AppState.tabs.length * row-height + 10px, root.window-height - root.height - 16px, 400px);
        Rectangle {
            background: Theme.chrome;
            border-width: 1px;
            border-color: Theme.control-border;
            border-radius: Theme.radius;
            FocusScope {
                capture-key-pressed(e) => {
                    if e.text == Key.Home {
                        root.focus-entry(0);
                    } else if e.text == Key.End {
                        root.focus-entry(AppState.tabs.length - 1);
                    } else if e.text == Key.UpArrow || e.text == Key.Backtab || (e.text == Key.Tab && e.modifiers.shift) {
                        root.focus-entry(root.menu-index - 1);
                    } else if e.text == Key.DownArrow || e.text == Key.Tab {
                        root.focus-entry(root.menu-index + 1);
                    } else {
                        return reject;
                    }
                    accept
                }
                KeepInView {
                    accessible-role: list;
                    accessible-label: @tr("Open documents");
                    x: 5px;
                    y: 5px;
                    width: parent.width - 10px;
                    height: parent.height - 10px;
                    inner-height: AppState.tabs.length * documents.row-height;
                    for doc[j] in AppState.tabs: Pressable {
                        y: j * documents.row-height;
                        width: parent.width;
                        height: documents.row-height;
                        border-radius: Theme.radius-small;
                        background: self.has-hover || self.has-focus ? Theme.hover : doc.active ? Theme.accent-soft : transparent;
                        accessible-role: list-item;
                        accessible-item-selectable: true;
                        accessible-item-selected: doc.active;
                        accessible-item-index: j;
                        accessible-item-count: AppState.tabs.length;
                        label: doc.title;
                        description: doc.folder + (doc.dirty ? " · " + @tr("Unsaved changes") : "");
                        property <int> focus-request: root.menu-focus;
                        changed focus-request => {
                            if j == root.menu-index { self.focus-row(); }
                        }
                        clicked => {
                            documents.close();
                            AppState.select-tab(j);
                        }
                        RowLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            cross-axis-alignment: center;
                            Image {
                                width: 16px;
                                height: 16px;
                                source: doc.active ? @image-url("icons/check.svg") : @image-url("icons/file.svg");
                                colorize: doc.active ? Theme.accent-fg : Theme.muted;
                                accessible-role: none;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: doc.title;
                                    font-weight: doc.active ? 600 : 500;
                                    font-size: Theme.font-body;
                                    color: Theme.text;
                                    overflow: elide;
                                    horizontal-alignment: Theme.rtl ? right : left;
                                    accessible-role: none;
                                }
                                Text {
                                    text: doc.folder;
                                    font-size: Theme.font-small;
                                    color: Theme.muted;
                                    overflow: elide;
                                    horizontal-alignment: Theme.rtl ? right : left;
                                    accessible-role: none;
                                }
                            }
                            if doc.dirty: Text {
                                text: @tr("Edited");
                                font-size: Theme.font-small;
                                color: Theme.accent-fg;
                                accessible-role: none;
                            }
                        }
                    }
                }
            }
        }
    }
}
