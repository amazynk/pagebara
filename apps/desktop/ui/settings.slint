import { AppState } from "state.slint";
import { SpellState } from "spell-menu.slint";
import { AboutPage } from "about.slint";
import { AppearancePicker } from "appearance-picker.slint";
import { Theme } from "theme.slint";
import { Button } from "components/button.slint";
import { Dialog, Divider, KeepInView } from "components/panel.slint";
import { RowLayout } from "components/row.slint";
import { Body, Heading, Hint, Choice, Field } from "components/dialog-parts.slint";
import { TextField } from "components/text-field.slint";
import { SegmentedControl, SegmentItem } from "components/segmented.slint";
import { SettingsChoices, SettingsSwitch, PreferenceCard } from "settings-controls.slint";

component SettingsNavigation inherits SettingsChoices {
    in property <bool> compact;
    in property <[SegmentItem]> items;
    accessible-role: tab-list;
    accessible-label: @tr("Settings");
    count: root.items.length;
    Rectangle {
        border-radius: 11px;
        background: Theme.canvas;
        Rectangle {
            x: root.compact ? 0px : Theme.rtl ? 0px : parent.width - 12px;
            y: root.compact ? parent.height - 12px : 0px;
            width: root.compact ? parent.width : 12px;
            height: root.compact ? 12px : parent.height;
            background: Theme.canvas;
        }
    }
    if !root.compact: Heading {
        x: 20px; y: 24px; width: root.width - 40px;
        text: @tr("Settings");
        font-size: Theme.font-heading;
    }
    for entry[i] in root.items: Rectangle {
        width: root.compact ? (root.width - 28px) / 4 : root.width - 24px;
        height: root.compact ? root.height - 16px : max(38px, Theme.control-height + 4px);
        x: root.compact ? 8px + (Theme.rtl ? 3 - i : i) * (self.width + 4px) : 12px;
        y: root.compact ? 8px : 70px + i * (self.height + 4px);
        border-radius: Theme.radius-small;
        background: i == root.selected ? Theme.accent-soft : hit.has-hover ? Theme.hover : transparent;
        border-color: Theme.focus;
        border-width: root.has-focus && i == root.selected ? Theme.focus-width : 0px;
        accessible-role: tab;
        accessible-label: entry.label;
        accessible-item-selectable: true;
        accessible-item-selected: i == root.selected;
        accessible-item-index: i;
        accessible-item-count: root.count;
        accessible-action-default => { root.choose(i); }
        if !root.compact: Image {
            x: Theme.rtl ? parent.width - self.width - 10px : 10px;
            source: entry.icon; colorize: i == root.selected ? Theme.accent-fg : Theme.muted;
            width: 17px; height: 17px; accessible-role: none;
        }
        Text {
            x: root.compact ? 2px : Theme.rtl ? 6px : 36px;
            width: parent.width - (root.compact ? 4px : 42px);
            height: parent.height;
            text: entry.label; color: i == root.selected ? Theme.accent-fg : Theme.text;
            font-size: Theme.font-body; font-weight: i == root.selected ? 600 : 500;
            horizontal-alignment: root.compact ? center : Theme.rtl ? right : left;
            vertical-alignment: center; wrap: word-wrap; accessible-role: none;
        }
        hit := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.focus(); root.choose(i); }
        }
    }
}

component PreferenceRow inherits RowLayout {
    in property <string> label;
    spacing: 12px;
    min-height: max(Theme.control-height, 36px);
    Body {
        text: root.label; color: Theme.text; vertical-alignment: center;
        horizontal-stretch: 1; accessible-role: none;
    }
    @children
}

export component SettingsDialog inherits Dialog {
    title: @tr("Settings");
    card-width: 780px;
    content-padding: 1px;
    auto-focus: false;
    forward-focus: nav;
    property <length> sheet-width: min(root.card-width, root.width - 32px) - 2px;
    property <bool> compact: root.sheet-width < 700px || (Theme.text-scale > 1.25 && root.sheet-width < 760px);
    property <length> gutter: root.compact ? 18px : 24px;
    property <string> author-draft: AppState.author;
    property <int> section <=> AppState.settings-section;
    property <[SegmentItem]> sections: [
        { label: @tr("General"), icon: @image-url("icons/gear.svg") },
        { label: @tr("Editing"), icon: @image-url("icons/edit.svg") },
        { label: @tr("System"), icon: @image-url("icons/layout.svg") },
        { label: @tr("About"), icon: @image-url("icons/info.svg") },
    ];
    changed section => {
        page-scroll.content-y = 0px;
        nav.focus();
        if section == 2 { AppState.integration-action("", "summary"); }
    }
    init => { nav.focus(); }
    changed visible => { if self.visible { nav.focus(); } }

    sheet := Rectangle {
        width: root.sheet-width;
        height: min(510px, root.height - 30px);
        nav := SettingsNavigation {
            x: !root.compact && Theme.rtl ? sheet.width - self.width : 0px;
            y: 0px;
            compact: root.compact;
            items: root.sections;
            selected: root.section;
            choose(i) => { root.section = i; }
            width: root.compact ? root.sheet-width : 172px * min(Theme.text-scale, 1.2);
            height: root.compact ? max(54px, Theme.control-height + 20px) : sheet.height;
        }
        Rectangle {
            x: root.compact ? 0px : Theme.rtl ? nav.x - 1px : nav.width;
            y: root.compact ? nav.height : 0px;
            width: root.compact ? sheet.width : 1px;
            height: root.compact ? 1px : sheet.height;
            background: Theme.border;
        }
        main := VerticalLayout {
            x: root.compact || Theme.rtl ? 0px : nav.width + 1px;
            y: root.compact ? nav.height + 1px : 0px;
            width: sheet.width - (root.compact ? 0px : nav.width + 1px);
            height: sheet.height - self.y;
            padding-left: root.gutter;
            padding-right: root.gutter;
            padding-top: root.compact ? 14px : 24px;
            padding-bottom: root.compact ? 12px : 16px;
            spacing: root.compact ? 10px : 14px;
            if root.section != 3: Heading {
                text: root.sections[root.section].label;
                font-size: 22px * Theme.text-scale;
            }
            page-scroll := KeepInView {
                width: main.width - 2 * root.gutter;
                vertical-stretch: 1;
                min-height: 0px;
                inner-height: pages.preferred-height;
                pages := VerticalLayout {
                    x: 0px; y: 0px;
                    width: page-scroll.width;
                    height: self.preferred-height;
                    padding-right: 6px;
                    padding-left: 2px;
                    padding-top: 2px;
                    padding-bottom: 4px;
                    alignment: start;
                    if root.section == 0: VerticalLayout {
                        spacing: 12px;
                        Body { text: @tr("Appearance"); color: Theme.text; font-weight: 600; }
                        AppearancePicker {}
                        PreferenceCard {
                            SettingsSwitch {
                                label: @tr("High contrast");
                                checked: Theme.high-contrast;
                                toggled(on) => { AppState.set-theme(Theme.dark ? (on ? 3 : 2) : (on ? 4 : 1)); }
                            }
                            Divider {}
                            PreferenceRow {
                                label: @tr("Text size");
                                SegmentedControl {
                                    name: @tr("Text size");
                                    items: [{ label: "100%" }, { label: "115%" }, { label: "130%" }, { label: "150%" }];
                                    selected: AppState.text-scale >= 1.45 ? 3 : AppState.text-scale >= 1.25 ? 2 : AppState.text-scale >= 1.1 ? 1 : 0;
                                    activated(i) => { AppState.set-text-scale([1, 1.15, 1.3, 1.5][i]); }
                                }
                            }
                            Divider {}
                            PreferenceRow {
                                label: @tr("Motion");
                                Choice {
                                    width: parent.width * 0.58;
                                    label: @tr("Motion");
                                    model: [@tr("Follow the system"), @tr("Reduce motion"), @tr("Smooth scrolling")];
                                    current-index: AppState.motion-choice;
                                    selected(i) => { AppState.set-motion(i); }
                                }
                            }
                            Divider {}
                            PreferenceRow {
                                label: @tr("Language");
                                Choice {
                                    width: parent.width * 0.58;
                                    label: @tr("Language");
                                    model: AppState.languages;
                                    current-index: AppState.language-index;
                                    selected(i) => { AppState.set-language(i); }
                                }
                            }
                        }
                    }
                    if root.section == 1: VerticalLayout {
                        spacing: 16px;
                        PreferenceCard {
                            Field {
                                label: @tr("Your name, shown on comments and highlights");
                                TextField {
                                    text <=> root.author-draft;
                                    placeholder: @tr("Your name");
                                    label: @tr("Author name");
                                }
                            }
                        }
                        PreferenceCard {
                            SettingsSwitch {
                                label: @tr("Check spelling as you type");
                                checked: SpellState.enabled;
                                toggled(on) => { SpellState.action("enabled", on ? "on" : "off"); }
                            }
                            Divider {}
                            SettingsSwitch {
                                // TRANSLATORS: "vim" is the text editor; the keys are typed as shown
                                label: @tr("Vim keys over the pages (h j k l, gg, /, :)");
                                checked: AppState.vim-keys;
                                toggled(on) => { AppState.set-vim-keys(on); }
                            }
                        }
                    }
                    if root.section == 2: VerticalLayout {
                        spacing: 14px;
                        PreferenceCard {
                            RowLayout {
                                spacing: 16px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Body { text: @tr("System integration"); color: Theme.text; font-weight: 600; }
                                    Hint { text: AppState.integration-summary; accessible-role: text; }
                                }
                                Button {
                                    text: @tr("Manage…");
                                    description: @tr("System integration");
                                    cross-axis-self-alignment: center;
                                    clicked => { AppState.integration-action("", "open"); }
                                }
                            }
                        }
                        if AppState.updates-available: PreferenceCard {
                            Body { text: @tr("Updates"); color: Theme.text; font-weight: 600; }
                            SettingsSwitch {
                                label: @tr("Check for updates automatically");
                                checked: AppState.check-updates;
                                toggled(on) => { AppState.check-updates = on; AppState.system-action("check-updates"); }
                            }
                            Divider {}
                            RowLayout {
                                spacing: 10px;
                                Button { text: @tr("Check now"); clicked => { AppState.system-action("check-now"); } }
                                Hint {
                                    text: AppState.update-status; horizontal-stretch: 1;
                                    cross-axis-self-alignment: center; accessible-role: text; accessible-live-region: polite;
                                }
                            }
                        }
                    }
                    if root.section == 3: AboutPage { viewport-height: page-scroll.height; }
                }
            }
            RowLayout {
                alignment: end;
                Button {
                    text: @tr("Done");
                    primary: true;
                    min-width: 68px;
                    clicked => { AppState.dialog-action("settings", root.author-draft); }
                }
            }
        }
    }
}
