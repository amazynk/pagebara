// Pieces the dialogs share: headings, body text, labelled fields, button rows, and the
// colours of verdicts (signatures, redaction checks).
import { RowLayout } from "row.slint";
import { Reveal } from "button.slint";
import { Theme } from "../theme.slint";
import { AppState } from "../state.slint";
import { MenuCard, MenuItem } from "panel.slint";

export global Verdicts {
    // 0 valid, 1 untrusted, 2 unknown, 3 invalid.
    out property <[color]> colours: [Theme.success, Theme.warning, Theme.muted, Theme.danger];
    out property <[color]> soft: [Theme.success-soft, Theme.warning-soft, Theme.track, Theme.danger-soft];
    out property <[string]> marks: ["✓", "!", "?", "✕"];
}

export component Heading inherits Text {
    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    color: Theme.text;
    font-size: Theme.font-heading;
    font-weight: 600;
    wrap: word-wrap;
    line-height-factor: 1.15;
    accessible-role: text;
}

export component Body inherits Text {
    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    color: Theme.muted;
    wrap: word-wrap;
    line-height-factor: 1.15;
}

export component Hint inherits Text {
    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    color: Theme.muted;
    font-size: Theme.font-small;
    wrap: word-wrap;
    line-height-factor: 1.15;
}

export component ErrorText inherits Text {
    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    text: AppState.dialog-error;
    color: Theme.danger;
    wrap: word-wrap;
    line-height-factor: 1.15;
    accessible-role: text;
    accessible-live-region: assertive;
    visible: AppState.dialog-error != "";
    height: AppState.dialog-error != "" ? self.preferred-height : 0px;
}

export component Buttons inherits RowLayout {
    padding-top: 8px;
    spacing: 8px;
    alignment: end;
}

export component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;
    Text {
        text: root.label;
        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        color: Theme.muted;
        font-size: Theme.font-small;
        font-weight: 500;
    }
    @children
}

// A rounded note, tinted by `level` (see Verdicts).
export component Note inherits Rectangle {
    in property <string> text;
    in property <int> level: 2;
    border-radius: Theme.radius-small;
    background: Verdicts.soft[level];
    height: t.preferred-height + 16px;
    t := Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.text;
        color: Theme.text;
        wrap: word-wrap;
        line-height-factor: 1.15;
        font-size: Theme.font-small;
        accessible-role: AccessibleRole.text;
    }
}

// A determinate progress bar.
export component Progress inherits Rectangle {
    in property <float> value;
    height: 6px;
    border-radius: 3px;
    background: Theme.track;
    Rectangle {
        x: 0px;
        width: parent.width * clamp(root.value, 0, 1);
        border-radius: 3px;
        background: Theme.accent;
    }
}

// A drop-down list in the app's look.
export component Choice inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <string> label;
    callback selected(index: int);
    height: Theme.touch ? 44px : 36px;
    border-radius: Theme.radius-small;
    background: touch.has-hover ? Theme.hover : Theme.chrome;
    border-width: keys.has-focus ? Theme.focus-width : Theme.high-contrast ? 2px : 1px;
    border-color: keys.has-focus ? Theme.focus : Theme.control-border;
    accessible-role: combobox;
    accessible-label: label;
    accessible-value: model[current-index];
    accessible-expandable: true;
    accessible-action-default => {
        popup.show();
    }
    accessible-action-expand => {
        popup.show();
    }
    forward-focus: keys;
    function pick(i: int) {
        if i >= 0 && i < model.length && i != current-index {
            current-index = i;
            selected(i);
        }
    }
    keys := FocusScope {
        changed has-focus => {
            if self.has-focus { Reveal.show(root.absolute-position.x, root.absolute-position.y, root.height); }
        }
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return || (e.text == Key.DownArrow && e.modifiers.alt) {
                popup.show();
                return accept;
            }
            if e.text == Key.DownArrow {
                root.pick(root.current-index + 1);
                return accept;
            }
            if e.text == Key.UpArrow {
                root.pick(root.current-index - 1);
                return accept;
            }
            if e.text == Key.Home {
                root.pick(0);
                return accept;
            }
            if e.text == Key.End {
                root.pick(root.model.length - 1);
                return accept;
            }
            reject
        }
    }
    RowLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        Text {
            text: root.model[root.current-index];
            horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: none;
        }
        Image {
            source: @image-url("../icons/chevron-down.svg");
            width: 14px;
            height: 14px;
            cross-axis-self-alignment: center;
            colorize: Theme.muted;
            accessible-role: none;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            popup.show();
        }
    }
    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        MenuCard {
            for item[i] in root.model: MenuItem {
                text: item;
                initial-focus: i == root.current-index;
                clicked => {
                    root.current-index = i;
                    root.selected(i);
                    popup.close();
                    keys.focus();
                }
            }
        }
    }
}

// A file path, shortened to fit.
export component PathText inherits Rectangle {
    in property <string> path;
    in property <string> placeholder;
    height: Theme.touch ? 44px : 36px;
    border-radius: Theme.radius-small;
    background: Theme.track;
    Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.path != "" ? root.path : root.placeholder;
        color: root.path != "" ? Theme.text : Theme.faint;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: AccessibleRole.text;
    }
}
