import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { Button, IconButton, Pressable } from "components/button.slint";
import { TextField } from "components/text-field.slint";

export struct LibraryDoc {
    name: string,
    folder: string,
    pages: string,
}

export struct LibraryHit {
    name: string,
    page: int,
    label: string,
    snippet: string,
}

// The library: known documents and folders, searched together on this device.
export global LibraryState {
    in property <bool> visible;
    in property <[string]> folders;
    in property <[LibraryDoc]> docs;
    in property <[LibraryHit]> hits;
    in-out property <string> query;
    in property <string> status;
    in property <bool> indexing;
    // 0..1 while indexing.
    in property <float> progress;
    callback show(visible: bool);
    callback add-folder();
    callback remove-folder(index: int);
    callback search(text: string);
    callback open-doc(index: int);
    callback open-hit(index: int);
    callback reindex();
    callback cancel();
}

component SectionTitle inherits Text {
    color: Theme.muted;
    font-size: Theme.font-small;
    font-weight: 600;
}

component Card inherits Rectangle {
    background: Theme.chrome;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
}

export component LibraryView inherits Rectangle {
    background: Theme.canvas;
    accessible-role: main;
    accessible-label: @tr("Library");
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(e) => {
            if AppState.shortcut(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt, e.modifiers.meta) {
                return accept;
            }
            reject
        }
        init => {
            field.focus-input();
        }

        VerticalLayout {
            Rectangle {
                height: Theme.toolbar-height;
                background: Theme.chrome;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 14px;
                    spacing: 10px;
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: (Theme.rtl ? @image-url("icons/chevron-right.svg") : @image-url("icons/chevron-left.svg"));
                        label: @tr("Close library");
                        clicked => {
                            LibraryState.show(false);
                        }
                    }
                    Text {
                        text: @tr("Library");
                        color: Theme.text;
                        font-size: Theme.font-title;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        text: @tr("Search stays on this device.");
                        color: Theme.faint;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        y: (parent.height - self.height) / 2;
                        height: Theme.control-height;
                        text: @tr("Add folder…");
                        icon: @image-url("icons/folder.svg");
                        clicked => {
                            LibraryState.add-folder();
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                alignment: center;
                VerticalLayout {
                    width: min(760px, root.width - 32px);
                    padding-top: 20px;
                    padding-bottom: 12px;
                    spacing: 12px;

                    field := TextField {
                        placeholder: @tr("Search all documents");
                        label: @tr("Search library");
                        text <=> LibraryState.query;
                        edited(t) => {
                            LibraryState.search(t);
                        }
                        accepted(t) => {
                            LibraryState.search(t);
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        height: 24px;
                        Text {
                            text: LibraryState.status;
                            color: Theme.muted;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                            accessible-role: text;
                            accessible-label: @tr("Library status: {}", LibraryState.status);
                            accessible-live-region: polite;
                        }
                        if LibraryState.indexing: Rectangle {
                            width: 120px;
                            height: 4px;
                            y: (parent.height - 4px) / 2;
                            border-radius: 2px;
                            background: Theme.track;
                            Rectangle {
                                x: 0;
                                width: parent.width * LibraryState.progress;
                                border-radius: 2px;
                                background: Theme.accent;
                            }
                        }
                        if LibraryState.indexing: Button {
                            height: 24px;
                            text: @tr("Cancel");
                            clicked => {
                                LibraryState.cancel();
                            }
                        }
                        if !LibraryState.indexing: Button {
                            height: 24px;
                            text: @tr("Update index");
                            clicked => {
                                LibraryState.reindex();
                            }
                        }
                    }

                    Flickable {
                        vertical-stretch: 1;
                        content-height: body.preferred-height;
                        body := VerticalLayout {
                            spacing: 10px;

                            if LibraryState.query != "": SectionTitle {
                                // TRANSLATORS: heading of the search results
                                text: LibraryState.hits.length == 0 ? @tr("No matches") : @tr("Matches");
                            }
                            if LibraryState.query != "" && LibraryState.hits.length > 0: Card {
                                VerticalLayout {
                                    padding: 4px;
                                    for h[i] in LibraryState.hits: Pressable {
                                        height: Theme.touch ? 64px : 56px;
                                        border-radius: Theme.radius-small;
                                        background: self.has-hover ? Theme.hover : transparent;
                                        label: @tr("Open {} at page {}", h.name, h.label);
                                        description: h.snippet;
                                        clicked => {
                                            LibraryState.open-hit(i);
                                        }
                                        VerticalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            alignment: center;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text {
                                                    text: h.name;
                                                    color: Theme.text;
                                                    font-weight: 500;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: @tr("page {}", h.label);
                                                    color: Theme.faint;
                                                    font-size: Theme.font-small;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                            Text {
                                                text: h.snippet;
                                                color: Theme.muted;
                                                font-size: Theme.font-small;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }

                            if LibraryState.query == "": SectionTitle {
                                text: @tr("Documents");
                            }
                            if LibraryState.query == "" && LibraryState.docs.length == 0: Text {
                                text: @tr("Documents you open and PDF files in folders you add show up here.");
                                color: Theme.muted;
                                wrap: word-wrap;
                                line-height-factor: 1.15;
                            }
                            if LibraryState.query == "" && LibraryState.docs.length > 0: Card {
                                VerticalLayout {
                                    padding: 4px;
                                    for d[i] in LibraryState.docs: Pressable {
                                        height: Theme.touch ? 52px : 44px;
                                        border-radius: Theme.radius-small;
                                        background: self.has-hover ? Theme.hover : transparent;
                                        label: @tr("Open {}", d.name);
                                        description: d.pages;
                                        clicked => {
                                            LibraryState.open-doc(i);
                                        }
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 10px;
                                            Image {
                                                accessible-role: none;
                                                source: @image-url("icons/file.svg");
                                                width: 18px;
                                                height: 18px;
                                                y: (parent.height - self.height) / 2;
                                                colorize: Theme.muted;
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                horizontal-stretch: 1;
                                                Text {
                                                    text: d.name;
                                                    color: Theme.text;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: d.folder;
                                                    color: Theme.faint;
                                                    font-size: Theme.font-small;
                                                    overflow: elide;
                                                }
                                            }
                                            Text {
                                                text: d.pages;
                                                color: Theme.faint;
                                                font-size: Theme.font-small;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            if LibraryState.query == "": SectionTitle {
                                text: @tr("Folders");
                            }
                            if LibraryState.query == "" && LibraryState.folders.length == 0: Text {
                                text: @tr("No folders yet. Add one to search the PDF files in it.");
                                color: Theme.muted;
                                wrap: word-wrap;
                                line-height-factor: 1.15;
                            }
                            if LibraryState.query == "" && LibraryState.folders.length > 0: Card {
                                VerticalLayout {
                                    padding: 4px;
                                    for f[i] in LibraryState.folders: Rectangle {
                                        height: 40px;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 4px;
                                            spacing: 10px;
                                            Image {
                                                accessible-role: none;
                                                source: @image-url("icons/folder.svg");
                                                width: 18px;
                                                height: 18px;
                                                y: (parent.height - self.height) / 2;
                                                colorize: Theme.muted;
                                            }
                                            Text {
                                                text: f;
                                                color: Theme.text;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                            IconButton {
                                                y: (parent.height - self.height) / 2;
                                                icon: @image-url("icons/close.svg");
                                                label: @tr("Remove folder {}", f);
                                                icon-size: 15px;
                                                clicked => {
                                                    LibraryState.remove-folder(i);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
