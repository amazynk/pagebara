import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { Button, Pressable } from "components/button.slint";
import { Dialog } from "components/panel.slint";
import { TextField } from "components/text-field.slint";

component Hint inherits HorizontalLayout {
    in property <image> icon;
    in property <string> text;
    in property <bool> warn;
    spacing: 6px;
    Image {
        accessible-role: none;
        source: root.icon;
        width: 14px;
        height: 14px;
        colorize: root.warn ? Theme.danger : Theme.muted;
    }
    Text {
        text: root.text;
        color: root.warn ? Theme.danger : Theme.muted;
        font-size: Theme.font-small;
        wrap: word-wrap;
        line-height-factor: 1.15;
        horizontal-stretch: 1;
    }
}

export component PasswordDialog inherits Dialog {
    property <bool> show-password;
    cancel => {
        AppState.cancel-unlock();
    }
    title: @tr("This document is protected");
    card-width: 440px;

    auto-focus: false;
    forward-focus: field;
    init => {
        field.focus-input();
    }

    function submit() {
        if field.text != "" && !AppState.unlocking {
            AppState.unlock(field.text);
            field.select-all();
        }
    }

    Rectangle {
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: Theme.accent-soft;
        Image {
            accessible-role: none;
            source: @image-url("icons/lock.svg");
            width: 22px;
            height: 22px;
            colorize: Theme.accent;
        }
    }
    Text {
        text: @tr("This document is protected");
        color: Theme.text;
        font-size: Theme.font-heading;
        font-weight: 600;
        accessible-role: text;
    }
    Text {
        text: @tr("“{}” is protected with a password. Enter it to open the document.", AppState.password-file);
        color: Theme.muted;
        wrap: word-wrap;
        line-height-factor: 1.15;
    }
    field := TextField {
        password: !root.show-password;
        placeholder: @tr("Password");
        label: @tr("Password");
        error: AppState.password-error;
        accepted => {
            root.submit();
        }
        Pressable {
            width: show.preferred-width + 8px;
            arrows: false;
            label: root.show-password ? @tr("Hide password") : @tr("Show password");
            clicked => {
                root.show-password = !root.show-password;
            }
            show := Text {
                x: 4px;
                // TRANSLATORS: show or hide the typed password
                text: root.show-password ? @tr("Hide") : @tr("Show");
                color: Theme.accent-fg;
                font-weight: 500;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }
    if AppState.password-error: Text {
        text: @tr("That password did not work. Check that Caps Lock is off and that the keyboard is set to the right language.");
        color: Theme.danger;
        wrap: word-wrap;
        line-height-factor: 1.15;
        accessible-role: text;
        accessible-live-region: assertive;
    }
    VerticalLayout {
        spacing: 6px;
        Hint {
            icon: @image-url("icons/keyboard.svg");
            text: @tr("Keyboard language: {}", AppState.keyboard-language);
        }
        Hint {
            icon: @image-url("icons/caps.svg");
            text: !field.caps-known ? @tr("Check that Caps Lock is off") : field.caps-lock ? @tr("Caps Lock is on") : @tr("Caps Lock is off");
            warn: field.caps-lock;
        }
        Hint {
            icon: @image-url("icons/info.svg");
            text: @tr("The password comes from whoever sent you the file, often in a separate message.");
        }
    }
    HorizontalLayout {
        padding-top: 8px;
        spacing: 8px;
        alignment: end;
        Button {
            text: @tr("Cancel");
            clicked => {
                AppState.cancel-unlock();
            }
        }
        Button {
            // TRANSLATORS: verb, on a button that opens the document
            text: AppState.unlocking ? @tr("Opening…") : @tr("Open");
            primary: true;
            enabled: field.text != "" && !AppState.unlocking;
            clicked => {
                root.submit();
            }
        }
    }
}
