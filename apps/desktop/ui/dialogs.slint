import { ScrollView } from "std-widgets.slint";
import { SettingsDialog } from "settings.slint";
import { Theme } from "theme.slint";
import { AppState, DialogKind } from "state.slint";
import { Button, Keys } from "components/button.slint";
import { Dialog } from "components/panel.slint";
import { TextField } from "components/text-field.slint";
import { SegmentedControl } from "components/segmented.slint";
import { ChoiceRow, Check } from "components/controls.slint";
import { RowLayout } from "components/row.slint";

component Heading inherits Text {
    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    color: Theme.text;
    font-size: Theme.font-heading;
    font-weight: 600;
    wrap: word-wrap;
    line-height-factor: 1.15;
    accessible-role: text;
}

component Body inherits Text {
    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    color: Theme.muted;
    wrap: word-wrap;
    line-height-factor: 1.15;
}

component ErrorText inherits Text {
    text: AppState.dialog-error;
    color: Theme.danger;
    wrap: word-wrap;
    line-height-factor: 1.15;
    accessible-role: text;
    accessible-live-region: assertive;
    visible: AppState.dialog-error != "";
    height: AppState.dialog-error != "" ? self.preferred-height : 0px;
}

component Buttons inherits RowLayout {
    padding-top: 8px;
    spacing: 8px;
    alignment: end;
}

component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;
    Text {
        text: root.label;
        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        color: Theme.muted;
        font-size: Theme.font-small;
        font-weight: 500;
    }
    @children
}

component UnsavedDialog inherits Dialog {
    title: @tr("Unsaved changes");
    Heading {
        text: AppState.dialog-title;
    }
    Body {
        text: @tr("Your changes will be lost if you don't save them.");
    }
    Buttons {
        Button {
            text: @tr("Don't save");
            clicked => {
                AppState.dialog-action("discard", "");
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Button {
            text: @tr("Cancel");
            clicked => {
                AppState.dialog-action("cancel", "");
            }
        }
        Button {
            text: @tr("Save");
            primary: true;
            clicked => {
                AppState.dialog-action("save", "");
            }
        }
    }
}

component ProtectDialog inherits Dialog {
    // The open password typed again.
    property <string> repeated;
    title: @tr("Protect");
    // The first field takes the keys: the password is what this dialog is for.
    auto-focus: false;
    forward-focus: user;
    init => {
        user.focus-input();
    }
    card-width: 460px;
    Heading {
        text: @tr("Protect “{}”", AppState.title);
    }
    Body {
        text: @tr("Anyone opening the file needs the password, if you set one. The owner password unlocks the actions you do not allow. Passwords may use any characters.");
    }
    Field {
        label: @tr("Password to open (leave empty for none)");
        user := TextField {
            password: true;
            placeholder: @tr("No password");
            label: @tr("Password to open");
        }
    }
    // A typo in a new password would lock the file for good: it is typed twice.
    if user.text != "": Field {
        label: @tr("Repeat the password to open");
        repeat := TextField {
            password: true;
            label: @tr("Repeat the password to open");
            error: self.text != "" && self.text != user.text;
            init => {
                root.repeated = "";
            }
            edited(text) => {
                root.repeated = text;
            }
        }
        if repeat.text != "" && repeat.text != user.text: Text {
            text: @tr("The two passwords are not the same.");
            color: Theme.danger;
            font-size: Theme.font-small;
        }
    }
    Field {
        label: @tr("Owner password");
        owner := TextField {
            password: true;
            placeholder: @tr("Owner password");
            label: @tr("Owner password");
        }
    }
    Text {
        text: @tr("Allow");
        color: Theme.muted;
        font-size: Theme.font-small;
        font-weight: 500;
    }
    GridLayout {
        spacing: 4px;
        Row {
            Check {
                text: @tr("Printing");
                checked: AppState.permissions[0];
                toggled => {
                    AppState.permissions[0] = self.checked;
                }
            }
            Check {
                text: @tr("Copying text");
                checked: AppState.permissions[1];
                toggled => {
                    AppState.permissions[1] = self.checked;
                }
            }
        }
        Row {
            Check {
                text: @tr("Editing");
                checked: AppState.permissions[2];
                toggled => {
                    AppState.permissions[2] = self.checked;
                }
            }
            Check {
                text: @tr("Comments");
                checked: AppState.permissions[3];
                toggled => {
                    AppState.permissions[3] = self.checked;
                }
            }
        }
        Row {
            Check {
                text: @tr("Filling forms");
                checked: AppState.permissions[4];
                toggled => {
                    AppState.permissions[4] = self.checked;
                }
            }
            Check {
                text: @tr("Changing pages");
                checked: AppState.permissions[5];
                toggled => {
                    AppState.permissions[5] = self.checked;
                }
            }
        }
    }
    ErrorText { }
    Buttons {
        if AppState.encrypted: Button {
            text: @tr("Remove protection");
            clicked => {
                AppState.dialog-action("unprotect", "");
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Button {
            text: @tr("Cancel");
            clicked => {
                AppState.dialog-action("cancel", "");
            }
        }
        Button {
            text: @tr("Protect");
            primary: true;
            enabled: (user.text != "" || owner.text != "") && (user.text == "" || root.repeated == user.text);
            clicked => {
                AppState.dialog-action("protect", user.text + "\u{1f}" + owner.text);
            }
        }
    }
}

component PropertiesDialog inherits Dialog {
    title: @tr("Document properties");
    card-width: 520px;
    Heading {
        text: @tr("Document properties");
    }
    VerticalLayout {
        spacing: 6px;
        for r in AppState.info: HorizontalLayout {
            spacing: 16px;
            if Theme.rtl: Text {
                text: r.value;
                color: Theme.text;
                wrap: word-wrap;
                line-height-factor: 1.15;
                horizontal-stretch: 1;
                horizontal-alignment: right;
                accessible-role: text;
                accessible-label: r.label + ": " + r.value;
            }
            Text {
                text: r.label;
                color: Theme.muted;
                width: 140px;
                wrap: word-wrap;
                line-height-factor: 1.15;
                horizontal-alignment: Theme.rtl ? right : left;
            }
            if !Theme.rtl: Text {
                text: r.value;
                color: Theme.text;
                wrap: word-wrap;
                line-height-factor: 1.15;
                horizontal-stretch: 1;
                accessible-role: text;
                accessible-label: r.label + ": " + r.value;
            }
        }
    }
    Buttons {
        Button {
            text: @tr("Close");
            primary: true;
            clicked => {
                AppState.dialog-action("cancel", "");
            }
        }
    }
}

component SplitDialog inherits Dialog {
    title: @tr("Split");
    card-width: 440px;
    Heading {
        text: @tr("Split into several files");
    }
    SegmentedControl {
        stretch: true;
        // TRANSLATORS: the split options, read by screen readers
        name: @tr("Split");
        items: [{ label: @tr("By page ranges") }, { label: @tr("Every few pages") }];
        selected <=> AppState.split-mode;
    }
    if AppState.split-mode == 0: Field {
        label: @tr("One file per range, for example 1-3, 4-7, 8-");
        TextField {
            text <=> AppState.split-ranges;
            placeholder: "1-3, 4-7, 8-";
            label: @tr("Page ranges");
        }
    }
    if AppState.split-mode == 1: Field {
        label: @tr("Pages per file");
        every := TextField {
            text: AppState.split-every;
            label: @tr("Pages per file");
            edited(t) => {
                AppState.split-every = t.to-float();
            }
        }
    }
    Body {
        text: @tr("You choose a folder next. The files are named after this document with the page numbers.");
    }
    ErrorText { }
    Buttons {
        Button {
            text: @tr("Cancel");
            clicked => {
                AppState.dialog-action("cancel", "");
            }
        }
        Button {
            text: @tr("Split…");
            primary: true;
            clicked => {
                AppState.dialog-action("split", "");
            }
        }
    }
}

component CropDialog inherits Dialog {
    // TRANSLATORS: title of the dialog that crops pages
    title: @tr("Crop");
    card-width: 420px;
    Heading {
        text: @tr("Crop pages");
    }
    Body {
        text: AppState.crop-all ? @tr("Margins to cut from every page, in millimetres.") : @tr("Margins to cut from the selected pages, in millimetres.");
    }
    GridLayout {
        spacing: 10px;
        Row {
            Field {
                // TRANSLATORS: the left margin
                label: @tr("Left");
                TextField {
                    text: AppState.crop-margins[0];
                    label: @tr("Left margin");
                    edited(t) => {
                        AppState.crop-margins[0] = t.to-float();
                    }
                }
            }
            Field {
                label: @tr("Top");
                TextField {
                    text: AppState.crop-margins[1];
                    label: @tr("Top margin");
                    edited(t) => {
                        AppState.crop-margins[1] = t.to-float();
                    }
                }
            }
        }
        Row {
            Field {
                label: @tr("Right");
                TextField {
                    text: AppState.crop-margins[2];
                    label: @tr("Right margin");
                    edited(t) => {
                        AppState.crop-margins[2] = t.to-float();
                    }
                }
            }
            Field {
                label: @tr("Bottom");
                TextField {
                    text: AppState.crop-margins[3];
                    label: @tr("Bottom margin");
                    edited(t) => {
                        AppState.crop-margins[3] = t.to-float();
                    }
                }
            }
        }
    }
    ErrorText { }
    Buttons {
        Button {
            text: @tr("Show whole page");
            clicked => {
                AppState.dialog-action("uncrop", "");
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Button {
            text: @tr("Cancel");
            clicked => {
                AppState.dialog-action("cancel", "");
            }
        }
        Button {
            // TRANSLATORS: verb, on the button that crops the pages
            text: @tr("Crop");
            primary: true;
            clicked => {
                AppState.dialog-action("crop", "");
            }
        }
    }
}

component IntegrationDialog inherits Dialog {
    cancel => { AppState.integration-action("", "close"); }
    title: @tr("System integration");
    card-width: 620px;
    heading := Heading {
        text: @tr("System integration");
    }
    intro := Body {
        text: Keys.macos
            ? @tr("Turn on the actions you want, then Control-click a PDF or image in Finder and choose Quick Actions.")
            : @tr("Choose how {} works with your system. Everything is for your account only, and turning an item off removes exactly what it added.", AppState.app-name);
    }
    rows := ScrollView {
        // Reserve room for the header and actions so only the list needs to scroll.
        height: clamp(root.height - 120px - heading.preferred-height - intro.preferred-height
            - status.height - actions.preferred-height, 60px, min(520px, list.preferred-height));
        content-width: self.visible-width;
        content-height: list.preferred-height;
        list := VerticalLayout {
            width: rows.visible-width;
            height: self.preferred-height;
            spacing: 10px;
            padding-right: 12px;
            for r in AppState.integration-rows: VerticalLayout {
                spacing: 2px;
                // Always there (zero high when empty): conditional elements inside a
                // repeated layout do not count towards the scrolled height.
                Text {
                    text: r.group;
                    color: Theme.text;
                    font-weight: 600;
                    accessible-role: text;
                    visible: r.group != "";
                    height: r.group != "" ? self.preferred-height : 0px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    // Its children are conditional: the height is given here.
                    min-height: 32px;
                    if r.check: Check {
                        text: r.title;
                        checked: r.on;
                        enabled: r.toggle && !AppState.integration-busy;
                        horizontal-stretch: 1;
                        toggled => {
                            AppState.integration-action(r.id, self.checked ? "on" : "off");
                        }
                    }
                    if !r.check: Text {
                        text: r.title;
                        color: Theme.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if r.button != "": Button {
                        text: r.button;
                        enabled: !AppState.integration-busy;
                        clicked => {
                            AppState.integration-action(r.id, "button");
                        }
                    }
                }
                Text {
                    text: r.explain;
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                    line-height-factor: 1.15;
                    // A fixed width, so the wrapped height counts in the scrolled height.
                    width: list.width - 12px;
                }
                Text {
                    text: r.status;
                    color: r.toggle ? Theme.accent : Theme.muted;
                    font-size: Theme.font-small;
                    font-italic: !r.toggle;
                    wrap: word-wrap;
                    line-height-factor: 1.15;
                    // A fixed width, so the wrapped height counts in the scrolled height.
                    width: list.width - 12px;
                    accessible-role: text;
                    visible: r.status != "";
                    height: r.status != "" ? self.preferred-height : 0px;
                }
            }
        }
    }
    status := Text {
        text: AppState.integration-status;
        color: Theme.muted;
        wrap: word-wrap;
        line-height-factor: 1.15;
        accessible-role: text;
        accessible-live-region: polite;
        visible: AppState.integration-status != "";
        height: AppState.integration-status != "" ? self.preferred-height : 0px;
    }
    actions := Buttons {
        Button {
            text: @tr("Remove all system integration");
            enabled: !AppState.integration-busy;
            clicked => {
                AppState.integration-action("", "remove-all");
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        close-button := Button {
            text: AppState.integration-from-settings ? @tr("Back") : @tr("Done");
            primary: true;
            clicked => {
                AppState.integration-action("", "close");
            }
        }
    }
}

component UpdateDialog inherits Dialog {
    title: @tr("Update available");
    Heading {
        text: @tr("Version {} is available", AppState.update-version);
    }
    if AppState.update-notes != "": Body {
        text: AppState.update-notes;
        accessible-role: text;
    }
    if !AppState.update-can-install: Body {
        text: AppState.update-how;
        accessible-role: text;
    }
    if AppState.update-status != "": Body {
        text: AppState.update-status;
        accessible-role: text;
        accessible-live-region: polite;
    }
    Buttons {
        Button {
            text: @tr("Skip this version");
            clicked => {
                AppState.system-action("skip-update");
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Button {
            text: AppState.update-can-install ? @tr("Later") : @tr("Close");
            clicked => {
                AppState.system-action("update-later");
            }
        }
        if AppState.update-can-install: Button {
            text: AppState.update-how;
            primary: true;
            clicked => {
                AppState.system-action("install-update");
            }
        }
    }
}

component DrawSignatureDialog inherits Dialog {
    title: @tr("Draw a signature");
    card-width: 560px;
    Heading {
        text: @tr("Draw your signature");
    }
    Body {
        text: @tr("Sign with the mouse, a pen or your finger. Clear starts over.");
    }
    Rectangle {
        height: 220px;
        border-radius: 8px;
        background: #FFFFFF;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;
        Rectangle {
            x: 24px;
            y: parent.height - 48px;
            width: parent.width - 48px;
            height: 1px;
            background: #D4D4D8;
        }
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: parent.width / 1px;
            viewbox-height: parent.height / 1px;
            commands: AppState.dialog-text;
            stroke: AppState.sig-ink == 2 ? #0B247A : #101010;
            stroke-width: 2.5px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
        canvas := TouchArea {
            mouse-cursor: crosshair;
            accessible-role: image;
            accessible-label: @tr("Signature canvas");
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    AppState.sig-draw(0, self.mouse-x / 1px, self.mouse-y / 1px);
                }
                if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                    AppState.sig-draw(2, self.mouse-x / 1px, self.mouse-y / 1px);
                }
            }
            moved => {
                if self.pressed {
                    AppState.sig-draw(1, self.mouse-x / 1px, self.mouse-y / 1px);
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 12px;
        Field {
            horizontal-stretch: 1;
            // TRANSLATORS: the name of the signature
            label: @tr("Name");
            name := TextField {
                text: @tr("My signature");
                label: @tr("Signature name");
            }
        }
        Field {
            width: 180px;
            // TRANSLATORS: the colour of the signature ink
            label: @tr("Ink");
            ChoiceRow {
                height: 36px;
                items: [{ label: @tr("Black") }, { label: @tr("Dark blue") }];
                selected: max(0, AppState.sig-ink - 1);
                picked(i) => {
                    AppState.sig-ink = i + 1;
                }
            }
        }
    }
    ErrorText { }
    Buttons {
        Button {
            // TRANSLATORS: verb, on a button that erases the drawn signature
            text: @tr("Clear");
            clicked => {
                AppState.sig-draw(3, 0, 0);
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Button {
            text: @tr("Cancel");
            clicked => {
                AppState.dialog-action("cancel", "");
            }
        }
        Button {
            text: @tr("Save signature");
            primary: true;
            enabled: AppState.dialog-text != "";
            clicked => {
                AppState.dialog-action("save-drawing", name.text);
            }
        }
    }
}

component LinkDialog inherits Dialog {
    title: @tr("Open link");
    card-width: 460px;
    Heading {
        text: @tr("Open this link?");
    }
    Body {
        text: @tr("It opens in your web browser:");
    }
    Rectangle {
        border-radius: Theme.radius-small;
        background: Theme.track;
        height: url.preferred-height + 16px;
        url := Text {
            x: 10px;
            width: parent.width - 20px;
            text: AppState.dialog-text;
            color: Theme.text;
            wrap: word-wrap;
            line-height-factor: 1.15;
            accessible-role: text;
        }
    }
    Buttons {
        Button {
            text: @tr("Cancel");
            clicked => {
                AppState.dialog-action("cancel", "");
            }
        }
        Button {
            text: @tr("Open link");
            primary: true;
            clicked => {
                AppState.dialog-action("open-link", "");
            }
        }
    }
}

component MessageDialog inherits Dialog {
    title: AppState.dialog-title;
    Heading {
        text: AppState.dialog-title;
    }
    Body {
        text: AppState.dialog-text;
    }
    Buttons {
        Button {
            text: @tr("OK");
            primary: true;
            clicked => {
                AppState.dialog-action("cancel", "");
            }
        }
    }
}

component OwnerPasswordDialog inherits Dialog {
    title: @tr("Owner password");
    card-width: 440px;
    auto-focus: false;
    forward-focus: field;
    init => {
        field.focus-input();
    }
    Heading {
        text: AppState.dialog-title;
    }
    Body {
        text: AppState.dialog-text;
    }
    field := TextField {
        password: true;
        placeholder: @tr("Owner password");
        label: @tr("Owner password");
        error: AppState.dialog-error != "";
        accepted => {
            AppState.dialog-action("owner", self.text);
        }
    }
    ErrorText { }
    Buttons {
        Button {
            text: @tr("Cancel");
            clicked => {
                AppState.dialog-action("cancel", "");
            }
        }
        Button {
            text: @tr("Unlock");
            primary: true;
            enabled: field.text != "";
            clicked => {
                AppState.dialog-action("owner", field.text);
            }
        }
    }
}

component RenameDialog inherits Dialog {
    title: @tr("Rename signature");
    auto-focus: false;
    forward-focus: field;
    init => {
        field.focus-input();
        field.select-all();
    }
    Heading {
        text: @tr("Rename signature");
    }
    field := TextField {
        text: AppState.sig-name;
        label: @tr("Signature name");
        accepted => {
            AppState.dialog-action("rename", self.text);
        }
    }
    Buttons {
        Button {
            text: @tr("Cancel");
            clicked => {
                AppState.dialog-action("cancel", "");
            }
        }
        Button {
            text: @tr("Rename");
            primary: true;
            enabled: field.text != "";
            clicked => {
                AppState.dialog-action("rename", field.text);
            }
        }
    }
}

// Whichever dialog AppState.dialog names, over the whole window.
export component Dialogs inherits Rectangle {
    if AppState.dialog == DialogKind.unsaved: UnsavedDialog {
        width: root.width;
        height: root.height;
    }
    if AppState.dialog == DialogKind.protect: ProtectDialog {
        width: root.width;
        height: root.height;
    }
    if AppState.dialog == DialogKind.properties: PropertiesDialog {
        width: root.width;
        height: root.height;
    }
    if AppState.dialog == DialogKind.split: SplitDialog {
        width: root.width;
        height: root.height;
    }
    if AppState.dialog == DialogKind.crop: CropDialog {
        width: root.width;
        height: root.height;
    }
    if AppState.dialog == DialogKind.update: UpdateDialog {
        width: root.width;
        height: root.height;
    }
    if AppState.dialog == DialogKind.settings || (AppState.dialog == DialogKind.integration && AppState.integration-from-settings): SettingsDialog {
        visible: AppState.dialog == DialogKind.settings;
        width: root.width;
        height: root.height;
    }
    if AppState.dialog == DialogKind.integration: IntegrationDialog {
        width: root.width;
        height: root.height;
    }
    if AppState.dialog == DialogKind.draw-signature: DrawSignatureDialog {
        width: root.width;
        height: root.height;
    }
    if AppState.dialog == DialogKind.open-link: LinkDialog {
        width: root.width;
        height: root.height;
    }
    if AppState.dialog == DialogKind.message: MessageDialog {
        width: root.width;
        height: root.height;
    }
    if AppState.dialog == DialogKind.owner-password: OwnerPasswordDialog {
        width: root.width;
        height: root.height;
    }
    if AppState.dialog == DialogKind.rename-signature: RenameDialog {
        width: root.width;
        height: root.height;
    }
}
