# The library: a folder of generated samples is indexed in the background, a search
# finds the documents by name and title, then those with the phrase in their text, and
# opening one shows the page with the phrase found.
cursor on
# The file picker hands focus to a protected PDF's password dialog.
key ctrl+l
call answer-file "$SAMPLES/lease-protected.pdf"
key ctrl+o
await password.visible == true 5000
assert library.visible == false
key escape
assert password.visible == false
key ctrl+l
assert library.visible == true
call library-add "$SAMPLES"
wait 2500
assert library.indexing == false
assert library.docs >= 4
assert library.status contains up to date
assert library.folders == samples
# Pictures of the first pages are made for the rows in view.
await library.thumbnails >= 8 10000
call a11y-check
screenshot 15-library.png
# The folders are under the tool bar's Folders button.
click "Folders" 300
screenshot 15-folders.png
click 100,600 200
click "Search library" 300
type "fridge freezer" 400
wait 500
# Copies of the lease (protected, restricted, ...) match too.
assert library.hits >= 2
assert library.hit-list contains lease.pdf p4
screenshot 15-search.png
click "Open lease.pdf at page 4" 400
wait 1200
assert library.visible == false
assert tabs == 1
assert title contains lease
assert page == 4
# The phrase is found in the document too, so the next match is a key away.
assert find.status contains of
# Back in the library: nothing changed, so nothing is read again; a hit in another file
# opens it at its page, one in an open document just goes there.
key ctrl+l
wait 1500
assert library.changed == 0
call library-search "Prepared for the board"
wait 500
assert library.hits == 1
call library-open-hit 1
wait 1200
assert title == report.pdf
assert page == 1
call library show
call library-search "fridge freezer"
wait 500
click "Open lease.pdf at page 4" 400
wait 800
assert tabs == 2
assert page == 4
key ctrl+l
key escape
assert library.visible == false
# Names and titles first: the document opened last comes first, and Enter in the search
# field opens it. Down goes into the list, Up back to the search field.
key ctrl+l
call library-search ""
type "lease"
wait 500
assert library.hit:1 == lease.pdf
assert library.current == Open lease.pdf
screenshot 15-names.png
key down
key down
assert library.current != Open lease.pdf
key up
assert library.current == Open lease.pdf
key up
type "-r"
assert library.query == lease-r
key return
await library.visible == false 3000
await title == lease-restricted.pdf 3000
