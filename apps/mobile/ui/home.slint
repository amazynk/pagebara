// The start screen: open a PDF, or one of the recent ones.

import { RowLayout } from "row.slint";
import { Theme } from "theme.slint";
import { AppState, Sheet } from "state.slint";
import { Button } from "controls.slint";

export component Home inherits Rectangle {
    in property <length> top-inset;
    in property <length> bottom-inset;
    background: Theme.bg;
    accessible-role: none;

    VerticalLayout {
        padding-top: root.top-inset + 32px;
        padding-bottom: root.bottom-inset + 16px;
        padding-left: 20px;
        padding-right: 20px;
        spacing: 20px;
        alignment: start;

        Text {
            text: AppState.app-name;
            font-size: 32px;
            font-weight: 700;
            color: Theme.text;
            accessible-role: none;
        }
        Text {
            text: @tr("Read, highlight, sign and fill in PDFs. Your files stay on this device.");
            wrap: word-wrap;
            font-size: Theme.font-body;
            color: Theme.muted;
        }
        RowLayout {
            alignment: start;
            open-pdf := Button {
                text: @tr("Open a PDF");
                icon: @image-url("icons/folder.svg");
                primary: true;
                clicked => {
                    AppState.open();
                }
            }
        }
        RowLayout {
            alignment: start;
            language := Button {
                text: @tr("Language: {}", AppState.language-name);
                clicked => {
                    AppState.sheet = Sheet.language;
                }
            }
        }
        if AppState.home-hint != "": Text {
            text: AppState.home-hint;
            wrap: word-wrap;
            font-size: Theme.font-small;
            color: Theme.muted;
        }
        if AppState.recent.length > 0: Text {
            // TRANSLATORS: heading over the recently opened files
            text: @tr("Recent");
            font-size: Theme.font-title;
            font-weight: 600;
            color: Theme.text;
        }
        if AppState.recent.length > 0: Rectangle {
            height: min(AppState.recent.length * 64px, root.height - 320px - root.top-inset);
            background: Theme.chrome;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            Flickable {
                content-height: AppState.recent.length * 64px;
                for r[i] in AppState.recent: Rectangle {
                    y: i * 64px;
                    height: 64px;
                    background: touch.pressed ? Theme.pressed : transparent;
                    accessible-role: button;
                    accessible-label: r.name;
                    accessible-action-default => {
                        AppState.open-recent(i);
                    }
                    if i > 0: Rectangle {
                        x: 16px;
                        y: 0;
                        height: 1px;
                        width: parent.width - 16px;
                        background: Theme.border;
                    }
                    Image {
                        x: 16px;
                        width: 24px;
                        height: 24px;
                        source: @image-url("icons/file.svg");
                        colorize: Theme.muted;
                        accessible-role: none;
                    }
                    VerticalLayout {
                        x: 56px;
                        width: parent.width - 72px;
                        alignment: center;
                        Text {
                            text: r.name;
                            font-size: Theme.font-body;
                            color: Theme.text;
                            overflow: elide;
                        }
                        Text {
                            text: r.folder;
                            font-size: Theme.font-small;
                            color: Theme.muted;
                            overflow: elide;
                        }
                    }
                    touch := TouchArea {
                        clicked => {
                            AppState.open-recent(i);
                        }
                    }
                }
            }
        }
    }
}
