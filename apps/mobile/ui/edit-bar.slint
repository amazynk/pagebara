// Edit mode: the action bar for the selected page object (colour, opacity, arrange,
// duplicate, delete, replace image, edit text) and the bar shown while editing text.

import { RowLayout } from "row.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { Button, IconButton } from "controls.slint";

// An action of the bar: icon over label.
component BarAction inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> label: text;
    in property <bool> active;
    in property <bool> danger;
    callback clicked();

    min-width: 52px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }

    VerticalLayout {
        alignment: center;
        spacing: 2px;
        RowLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 28px;
                border-radius: 14px;
                background: root.active ? Theme.accent-soft : touch.pressed ? Theme.pressed : transparent;
                Image {
                    width: 22px;
                    height: 22px;
                    source: root.icon;
                    colorize: root.danger ? Theme.danger : root.active ? Theme.accent-fg : Theme.text;
                    accessible-role: none;
                }
            }
        }
        Text {
            text: root.text;
            font-size: Theme.font-small;
            color: root.danger ? Theme.danger : root.active ? Theme.accent-fg : Theme.muted;
            horizontal-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A choice in a row of the bar.
component Pill inherits Rectangle {
    in property <string> text;
    in property <string> label: text;
    in property <bool> checked;
    callback clicked();

    height: 36px;
    min-width: 56px;
    horizontal-stretch: 1;
    border-radius: 18px;
    background: root.checked ? Theme.accent-soft : touch.pressed ? Theme.pressed : Theme.bg;
    border-width: root.checked ? 1px : 0px;
    border-color: Theme.accent-fg;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    Text {
        text: root.text;
        font-size: Theme.font-small;
        font-weight: 600;
        color: root.checked ? Theme.accent-fg : Theme.text;
        accessible-role: none;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component EditBar inherits Rectangle {
    background: Theme.chrome;
    height: col.preferred-height;
    accessible-role: groupbox;
    accessible-label: @tr("Selected: {}", AppState.edit-description);

    // Taps on the bar do not reach the page behind.
    TouchArea { }
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    col := VerticalLayout {
        padding-top: 6px;
        padding-bottom: 4px;
        spacing: 4px;

        if AppState.edit-panel == 1: RowLayout {
            padding-left: 10px;
            padding-right: 10px;
            height: 44px;
            spacing: 2px;
            accessible-role: groupbox;
            accessible-label: AppState.edit-stroke-mode ? @tr("Outline colour") : @tr("Fill colour");
            if AppState.edit-can-fill && AppState.edit-can-stroke: Pill {
                cross-axis-self-alignment: center;
                horizontal-stretch: 0;
                // TRANSLATORS: which part of a shape gets the colour: its outline or its fill
                text: AppState.edit-stroke-mode ? @tr("shape" => "Outline") : @tr("Fill");
                label: AppState.edit-stroke-mode ? @tr("Colour the outline; switch to fill") : @tr("Colour the fill; switch to outline");
                clicked => {
                    AppState.edit-stroke-mode = !AppState.edit-stroke-mode;
                }
            }
            for c[i] in AppState.edit-colours: Rectangle {
                cross-axis-self-alignment: center;
                width: 40px;
                height: 40px;
                accessible-role: button;
                accessible-label: @tr("Colour {}", i + 1);
                accessible-action-default => {
                    AppState.edit-colour(c);
                }
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: c;
                    border-width: 1px;
                    border-color: #00000033;
                }
                TouchArea {
                    clicked => {
                        AppState.edit-colour(c);
                    }
                }
            }
        }

        if AppState.edit-panel == 2: RowLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;
            accessible-role: groupbox;
            accessible-label: @tr("Opacity");
            for p in [100, 75, 50, 25]: Pill {
                text: p + "%";
                label: @tr("Opacity {} percent", p);
                clicked => {
                    AppState.edit-opacity(p);
                }
            }
        }

        if AppState.edit-panel == 3: RowLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;
            accessible-role: groupbox;
            accessible-label: @tr("Arrange");
            Pill {
                // TRANSLATORS: bring the object to the front
                text: @tr("Front");
                label: @tr("Bring to front");
                clicked => {
                    AppState.edit-arrange(0);
                }
            }
            Pill {
                text: @tr("Forward");
                label: @tr("Bring forward");
                clicked => {
                    AppState.edit-arrange(1);
                }
            }
            Pill {
                text: @tr("Backward");
                label: @tr("Send backward");
                clicked => {
                    AppState.edit-arrange(2);
                }
            }
            Pill {
                // TRANSLATORS: send the object to the back (not "go back")
                text: @tr("arrange" => "Back");
                label: @tr("Send to back");
                clicked => {
                    AppState.edit-arrange(3);
                }
            }
        }

        Text {
            x: 16px;
            width: parent.width - 32px;
            text: AppState.edit-description;
            font-size: Theme.font-small;
            color: Theme.muted;
            overflow: elide;
            accessible-role: none;
        }

        RowLayout {
            height: 52px;
            padding-left: 4px;
            padding-right: 4px;
            alignment: space-around;
            if AppState.edit-is-text: BarAction {
                icon: @image-url("icons/text.svg");
                text: @tr("Edit text");
                clicked => {
                    AppState.edit-panel = 0;
                    AppState.edit-text-start();
                }
            }
            if AppState.edit-is-image: BarAction {
                icon: @image-url("icons/image.svg");
                // TRANSLATORS: verb, replaces the selected image
                text: @tr("Replace");
                label: @tr("Replace image");
                clicked => {
                    AppState.edit-panel = 0;
                    AppState.edit-replace-image();
                }
            }
            if AppState.edit-can-fill || AppState.edit-can-stroke: BarAction {
                icon: @image-url("icons/palette.svg");
                text: @tr("Colour");
                active: AppState.edit-panel == 1;
                clicked => {
                    AppState.edit-panel = AppState.edit-panel == 1 ? 0 : 1;
                }
            }
            BarAction {
                icon: @image-url("icons/opacity.svg");
                text: @tr("Opacity");
                active: AppState.edit-panel == 2;
                clicked => {
                    AppState.edit-panel = AppState.edit-panel == 2 ? 0 : 2;
                }
            }
            BarAction {
                icon: @image-url("icons/layers.svg");
                text: @tr("Arrange");
                active: AppState.edit-panel == 3;
                clicked => {
                    AppState.edit-panel = AppState.edit-panel == 3 ? 0 : 3;
                }
            }
            BarAction {
                icon: @image-url("icons/copy.svg");
                text: @tr("Duplicate");
                clicked => {
                    AppState.edit-duplicate();
                }
            }
            BarAction {
                icon: @image-url("icons/trash.svg");
                text: @tr("Delete");
                label: @tr("Delete object");
                danger: true;
                clicked => {
                    AppState.edit-panel = 0;
                    AppState.edit-delete();
                }
            }
        }
    }
}

// Bold or italic on or off while editing text.
component StyleToggle inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <bool> checked;
    in property <bool> italic;
    callback clicked();

    width: Theme.touch;
    height: Theme.touch;
    border-radius: Theme.touch / 2;
    background: root.checked ? Theme.accent-soft : touch.pressed ? Theme.pressed : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.clicked();
    }
    Text {
        text: root.text;
        font-size: Theme.font-title;
        font-weight: root.italic ? 400 : 800;
        font-italic: root.italic;
        color: root.checked ? Theme.accent-fg : Theme.text;
        accessible-role: none;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// While editing text: Cancel, Bold and Italic, and Done (over the keyboard).
export component TextEditBar inherits Rectangle {
    height: 56px;
    background: Theme.chrome;
    drop-shadow-blur: 8px;
    drop-shadow-color: Theme.shadow;
    accessible-role: groupbox;
    accessible-label: @tr("Editing text");

    TouchArea { }
    RowLayout {
        padding-left: 4px;
        padding-right: 8px;
        spacing: 8px;
        IconButton {
            cross-axis-self-alignment: center;
            icon: @image-url("icons/close.svg");
            label: @tr("Cancel text editing");
            clicked => {
                AppState.edit-text-done(false);
            }
        }
        StyleToggle {
            cross-axis-self-alignment: center;
            // TRANSLATORS: the first letter of "Bold", on the bold button
            text: @tr("B");
            label: @tr("Bold");
            checked: AppState.edit-text-bold;
            clicked => {
                AppState.edit-text-style(0);
            }
        }
        StyleToggle {
            cross-axis-self-alignment: center;
            // TRANSLATORS: the first letter of "Italic", on the italic button
            text: @tr("I");
            label: @tr("Italic");
            italic: true;
            checked: AppState.edit-text-italic;
            clicked => {
                AppState.edit-text-style(1);
            }
        }
        Text {
            horizontal-stretch: 1;
            text: @tr("Editing text");
            overflow: elide;
            font-size: Theme.font-body;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
            accessible-role: none;
        }
        Button {
            cross-axis-self-alignment: center;
            text: @tr("Done");
            icon: @image-url("icons/check.svg");
            primary: true;
            clicked => {
                AppState.edit-text-done(true);
            }
        }
    }
}
