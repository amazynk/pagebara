// Touch-sized controls.

import { RowLayout } from "row.slint";
import { Theme } from "theme.slint";

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> active;
    callback clicked();

    width: Theme.touch;
    height: Theme.touch;
    border-radius: Theme.touch / 2;
    background: touch.pressed ? Theme.pressed : root.active ? Theme.accent-soft : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    Image {
        width: 22px;
        height: 22px;
        source: root.icon;
        colorize: !root.enabled ? Theme.border : root.active ? Theme.accent-fg : Theme.text;
        accessible-role: none;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// A tool of the bottom bar: icon over label, the current one in the accent colour.
export component ToolButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();

    min-width: 56px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.active;
    accessible-checkable: true;
    accessible-action-default => {
        root.clicked();
    }

    VerticalLayout {
        alignment: center;
        spacing: 3px;
        RowLayout {
            alignment: center;
            Rectangle {
                width: 52px;
                height: 30px;
                border-radius: 15px;
                background: root.active ? Theme.accent-soft : touch.pressed ? Theme.pressed : transparent;
                Image {
                    width: 22px;
                    height: 22px;
                    source: root.icon;
                    colorize: root.active ? Theme.accent-fg : Theme.muted;
                    accessible-role: none;
                }
            }
        }
        Text {
            text: root.label;
            font-size: Theme.font-small;
            font-weight: root.active ? 600 : 400;
            color: root.active ? Theme.accent-fg : Theme.muted;
            horizontal-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();

    min-height: Theme.touch;
    max-height: Theme.touch;
    min-width: 88px;
    border-radius: Theme.touch / 2;
    background: !root.enabled ? Theme.border : root.primary ? (touch.pressed ? #1D4ED8 : Theme.accent) : (touch.pressed ? Theme.pressed : Theme.chrome);
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.border;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    RowLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 8px;
        alignment: center;
        if root.icon.width > 0: Image {
            cross-axis-self-alignment: center;
            width: 20px;
            height: 20px;
            source: root.icon;
            colorize: root.primary ? Theme.on-accent : Theme.text;
            accessible-role: none;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.font-body;
            font-weight: 600;
            color: root.primary ? Theme.on-accent : Theme.text;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// A row of a menu sheet.
export component MenuRow inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();

    height: 52px;
    background: touch.pressed ? Theme.pressed : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    RowLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 16px;
        Image {
            cross-axis-self-alignment: center;
            width: 22px;
            height: 22px;
            source: root.icon;
            colorize: root.enabled ? Theme.text : Theme.border;
            accessible-role: none;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.font-body;
            color: root.enabled ? Theme.text : Theme.muted;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// A panel sliding up from the bottom over a dimmed reader; a tap on the dim closes it.
export component BottomSheet inherits Rectangle {
    in property <string> title;
    in property <length> sheet-height: 300px;
    in property <length> bottom-inset;
    callback close();

    accessible-role: none;

    Rectangle {
        background: Theme.scrim;
        TouchArea {
            clicked => {
                root.close();
            }
        }
    }

    Rectangle {
        y: root.height - self.height;
        height: min(root.sheet-height + root.bottom-inset, root.height - 40px);
        background: Theme.chrome;
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
        accessible-role: groupbox;
        accessible-label: root.title;

        // Swallows taps so they do not reach the dim behind.
        TouchArea { }

        VerticalLayout {
            padding-bottom: root.bottom-inset;
            Rectangle {
                height: 20px;
                Rectangle {
                    width: 36px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.border;
                }
            }
            if root.title != "": RowLayout {
                padding-left: 20px;
                padding-right: 8px;
                height: 40px;
                Text {
                    text: root.title;
                    font-size: Theme.font-title;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
            @children
        }
    }
}
